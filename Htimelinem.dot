digraph timeline_mobile { graph [bgcolor="#ffffff", margin=0.25, label="timeline.html | mobile", labelloc=t, labeljust=l, fontname="DejaVu Sans Bold", fontsize=17, fontcolor="#14202e"]; node [shape=plaintext, fontname="DejaVu Sans", fontsize=11]; phone [label=< <TABLE BORDER="3" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#ffffff" WIDTH="380"> <TR><TD ALIGN="CENTER" HEIGHT="22" BGCOLOR="#14202e"><FONT POINT-SIZE="8" COLOR="#ffffff">status bar - viewport 390 x 844, single column, page scrolls</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="374" HEIGHT="140" FIXEDSIZE="TRUE" BGCOLOR="#e4e8ec"> <TR><TD ALIGN="LEFT" VALIGN="BOTTOM" CELLPADDING="8"> <FONT POINT-SIZE="7" COLOR="#5b6672">header.hero - img object-fit: cover, ~35-40vh<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="8" COLOR="#2f5d8c">p.kicker KO<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="13" COLOR="#14202e"><B>h1 Twenty Years<BR ALIGN="LEFT"/>in a Film!</B><BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="8" COLOR="#5b6672">p.sub wraps to 2 lines</FONT> </TD></TR> </TABLE> </TD></TR> <TR><TD BGCOLOR="#f2f3f5" CELLPADDING="0"> <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" WIDTH="374" COLOR="#9aa3ad"> <TR> <TD><FONT POINT-SIZE="8" COLOR="#14202e">Overview<BR/>KO</FONT></TD> <TD BGCOLOR="#14202e"><FONT POINT-SIZE="8" COLOR="#ffffff"><B>Timeline</B><BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="8" COLOR="#14202e">Network<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="8" COLOR="#14202e">PC Bang<BR/>KO</FONT></TD> <TD BGCOLOR="#e4e8ec"><FONT POINT-SIZE="12" COLOR="#5b6672">&#8250;</FONT></TD> </TR> <TR><TD COLSPAN="5" BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#5b6672">nav.topbar - horizontal scroll strip; Culture / Policy / References off-screen right</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="358"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#14202e"><B>h2 Twenty years;<BR ALIGN="LEFT"/>event by event</B></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c04c4c" STYLE="DASHED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" WIDTH="344"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#c04c4c">#tl-error [hidden] role="alert"</FONT></TD></TR></TABLE> </TD></TR> <TR><TD> <TABLE BORDER="2" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="344" HEIGHT="185" FIXEDSIZE="TRUE" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="CENTER" VALIGN="MIDDLE"><FONT POINT-SIZE="10" COLOR="#14202e"><B>div.tl-canvas#tl-canvas</B><BR/><FONT POINT-SIZE="7" COLOR="#5b6672">p5 canvas, resized by windowResized()<BR/><BR/>~344px for 20 years means the dots sit only a<BR/>few px apart - tapping one event is unreliable,<BR/>so lean on Prev / Next and the table here, or<BR/>stack the strip vertically (year down the page).<BR/>Year labels will need thinning to every 5 years.<BR/>Dragging on the canvas can block page scroll.</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="344" BGCOLOR="#ffffff"> <TR><TD> <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="7" WIDTH="330" COLOR="#2f5d8c"> <TR> <TD BGCOLOR="#14202e"><FONT POINT-SIZE="8" COLOR="#ffffff"><B>#tl-play</B></FONT></TD> <TD BORDER="0"><FONT POINT-SIZE="8" COLOR="#14202e"><B>#tl-year</B><BR/><FONT POINT-SIZE="7" COLOR="#5b6672">January 2006</FONT></FONT></TD> <TD BORDER="0"><FONT POINT-SIZE="8" COLOR="#14202e"><B>#tl-count</B><BR/><FONT POINT-SIZE="7" COLOR="#5b6672">0 events</FONT></FONT></TD> </TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="7" WIDTH="330" COLOR="#2f5d8c"> <TR> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#2f5d8c">#tl-prev</FONT></TD> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#2f5d8c">#tl-next</FONT></TD> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#2f5d8c">#tl-reset</FONT></TD> </TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#5b6672">div.tl-bar wraps to 2 rows: transport + readout on top,<BR ALIGN="LEFT"/>step controls below. .tl-spacer does nothing once wrapped.<BR ALIGN="LEFT"/>Buttons 44px tall; Prev/Next are the main way to move here.</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>div#tl-detail .tl-detail</B> aria-live<BR ALIGN="LEFT"/><FONT COLOR="#5b6672">p.tl-when / h3.tl-title / p.tl-note + [n]<BR ALIGN="LEFT"/>keep it directly under the bar so a<BR ALIGN="LEFT"/>Next tap and its result are both on<BR ALIGN="LEFT"/>screen. Reserve ~5 lines min-height:<BR ALIGN="LEFT"/>notes rewrite on every tick and the<BR ALIGN="LEFT"/>page will jump during playback.</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="344" BGCOLOR="#f2f3f5"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e">&#9656; "View every event as table"<BR ALIGN="LEFT"/><FONT COLOR="#5b6672">the usable way to browse events on a<BR ALIGN="LEFT"/>phone. When | Event | Thread will not fit<BR ALIGN="LEFT"/>344px - stack each row as a block with<BR ALIGN="LEFT"/>labels, keeping tr role="button" tabindex<BR ALIGN="LEFT"/>and a 44px tap height per row.<BR ALIGN="LEFT"/>caption keeps the data/timeline.json link.</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#14202e"><B>aside.band-side "On Next!"</B> (below)</FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">instructions paragraph. "arrow keys" and<BR ALIGN="LEFT"/>"drag the slider" do not apply on touch -<BR ALIGN="LEFT"/>reword or hide that sentence here.</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="330" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>ul.graph-key.tl-key#tl-key</B><BR ALIGN="LEFT"/>&#9679; Infrastructure &#9679; Mobile<BR ALIGN="LEFT"/>&#9679; Platform &#9679; Policy<BR ALIGN="LEFT"/>&#9679; Incident<BR ALIGN="LEFT"/><FONT COLOR="#c04c4c">li = role="button" aria-pressed thread<BR ALIGN="LEFT"/>filters. Wrap as chips, 44px tall - the<BR ALIGN="LEFT"/>most useful control on a small screen,<BR ALIGN="LEFT"/>so consider moving it above the canvas.</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">p.side-note - author's reading of the threads</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c04c4c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#fdf6f6"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>p.tl-sources#tl-sources</B> - [n] [n] [n] chips<BR ALIGN="LEFT"/><FONT COLOR="#c04c4c">single column, so it lands last in the band<BR ALIGN="LEFT"/>either way - the grid-column fix only<BR ALIGN="LEFT"/>matters at the 2-column breakpoint</FONT></FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="358"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#14202e"><B>h2 What shape shouts ?!</B></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672"><B>.band-main .prose</B> (1st in flow)<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P1 lead-in, three things stand out<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P2 infrastructure front-loads to 2019<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P3 policy is reactive<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P4 platform thread + external link<BR ALIGN="LEFT"/>_____________________________</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>aside "About data"</B><BR ALIGN="LEFT"/>dl.scope, dt over dd, long dd text:<BR ALIGN="LEFT"/><B>Source</B> ____________________<BR ALIGN="LEFT"/><B>Validation Criterion</B> _________<BR ALIGN="LEFT"/>&nbsp;&nbsp;&lt;code&gt;YYYY-MM&lt;/code&gt; chip must not<BR ALIGN="LEFT"/>&nbsp;&nbsp;overflow - allow it to break<BR ALIGN="LEFT"/><B>Rendering</B> _________________<BR ALIGN="LEFT"/><FONT COLOR="#5b6672">tallest block on the page after the<BR ALIGN="LEFT"/>canvas; a details toggle would help</FONT></FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD></TR> <TR><TD BGCOLOR="#14202e" CELLPADDING="10"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="354"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#ffffff"><B>A History of the Internet<BR ALIGN="LEFT"/>in South Korea</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#c9ced5">p.foot-note</FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#ffffff"><B>Sources on this page</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#c9ced5">ol.cites#page-cites - grows after the<BR ALIGN="LEFT"/>JSON loads and events are visited<BR ALIGN="LEFT"/>1. ____________________<BR ALIGN="LEFT"/>2. ____________________<BR ALIGN="LEFT"/>Full reference list &#8594;</FONT></TD></TR> <TR><TD ALIGN="LEFT" BGCOLOR="#0d1620"><FONT POINT-SIZE="7" COLOR="#9aa3ad">CM1040 - University of London<BR ALIGN="LEFT"/>Back to top &#8593;</FONT></TD></TR> <TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#5b6672">.foot-grid 2 cols becomes stacked</FONT></TD></TR> </TABLE> </TD></TR> </TABLE>>]; }
