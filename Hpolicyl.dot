digraph policy_laptop { graph [bgcolor="#ffffff", margin=0.25, label="policy.html | laptop", labelloc=t, labeljust=l, fontname="DejaVu Sans Bold", fontsize=17, fontcolor="#14202e"]; node [shape=plaintext, fontname="DejaVu Sans", fontsize=11]; page [label=< <TABLE BORDER="2" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#ffffff" WIDTH="1060"> <TR><TD ALIGN="LEFT" HEIGHT="24" BGCOLOR="#dde1e6"><FONT POINT-SIZE="9" COLOR="#5b6672"> viewport 1280 x 800 - a.skip then &lt;noscript&gt; - only page loading assets/css/policy.css, sql-wasm.js and policy.bundle.js</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="1060" HEIGHT="150" FIXEDSIZE="TRUE" BGCOLOR="#e4e8ec"> <TR><TD ALIGN="LEFT" VALIGN="BOTTOM" CELLPADDING="14"> <FONT POINT-SIZE="9" COLOR="#5b6672">header.hero - img.hero-img full bleed, .hero-text / .hero-inner overlay<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="9" COLOR="#2f5d8c">p.kicker KO (policy and the gap)<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="19" COLOR="#14202e"><B>h1 Rules; Rulings; Records</B><BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="10" COLOR="#5b6672">p.sub query the laws yourself, the database runs in your browser</FONT> </TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" WIDTH="1060" BGCOLOR="#f2f3f5" COLOR="#9aa3ad"> <TR> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Overview<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Timeline<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Network<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">PC Bang<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Culture<BR/>KO</FONT></TD> <TD BGCOLOR="#14202e"><FONT POINT-SIZE="9" COLOR="#ffffff"><B>Policy</B><BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">References<BR/>KO</FONT></TD> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#5b6672">nav.topbar - 7 items, one row<BR/>aria-current="page" on Policy</FONT></TD> </TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="10"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1030" BGCOLOR="#ffffff"> <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#14202e"><B>section.band - h2 "Ask the database"</B></FONT></TD></TR> <TR> <TD WIDTH="670" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="655" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#14202e"><B>div.pol-grid</B> <FONT POINT-SIZE="8" COLOR="#5b6672">(layout owned by policy.css - editor, bar, output stacked)</FONT></FONT></TD></TR> <TR><TD> <TABLE BORDER="2" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="641" HEIGHT="130" FIXEDSIZE="TRUE" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="CENTER" VALIGN="MIDDLE"><FONT POINT-SIZE="11" COLOR="#14202e"><B>div#pol-editor - SQL editor mounts here</B><BR/><FONT POINT-SIZE="9" COLOR="#5b6672">empty in the HTML; policy.bundle.js injects the editor<BR/>mono type, line numbers, syntax colour, several rows tall<BR/>needs a min-height in CSS or the page reflows on mount<BR/><BR/>this is an editable code surface, so it needs a label or<BR/>aria-label - right now nothing names it for a screen reader</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" WIDTH="641"> <TR> <TD WIDTH="110"> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#14202e"><TR><TD><FONT POINT-SIZE="10" COLOR="#ffffff"><B>#pol-run "Run"</B></FONT></TD></TR></TABLE> </TD> <TD WIDTH="531" ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">p.pol-note#pol-note - starts as "Loading..." while the wasm binary and the<BR ALIGN="LEFT"/>database fetch, then becomes the status line (row count, timing, or the error)</FONT></TD> </TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#c04c4c">div.pol-bar - #pol-run should be disabled while #pol-note reads "Loading...", or the first click runs against nothing</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="641" HEIGHT="145" FIXEDSIZE="TRUE" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT" VALIGN="TOP" CELLPADDING="8"><FONT POINT-SIZE="10" COLOR="#14202e"><B>div#pol-out role="region" aria-live="polite" aria-label="Query results"</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#5b6672">result table written after each Run: header row + N data rows<BR ALIGN="LEFT"/>_______________________________________________________<BR ALIGN="LEFT"/>_______________________________________________________<BR ALIGN="LEFT"/>_______________________________________________________<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>column count depends on the query, so it needs overflow-x and a<BR ALIGN="LEFT"/>max-height with its own scroll - a SELECT * can return wide rows.<BR ALIGN="LEFT"/>aria-live on a whole results table will read the entire thing out;<BR ALIGN="LEFT"/>announcing just the row count in #pol-note would be kinder.</FONT></FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD> <TD WIDTH="345" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="330" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#14202e"><B>aside.band-side - h3.side-h "Try one"</B></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="310" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>div#pol-presets</B> - empty in the HTML,<BR ALIGN="LEFT"/>filled by the bundle<BR ALIGN="LEFT"/><FONT POINT-SIZE="7" COLOR="#5b6672">a list of clickable preset queries, e.g.<BR ALIGN="LEFT"/>[ Rulings joined to the law they concerned ]<BR ALIGN="LEFT"/>[ How long each law lasted ]<BR ALIGN="LEFT"/>[ Breaches by year ]<BR ALIGN="LEFT"/>clicking one loads it into #pol-editor -<BR ALIGN="LEFT"/>these must be real buttons, and the two<BR ALIGN="LEFT"/>presets named in the prose below have to<BR ALIGN="LEFT"/>match these labels exactly</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#14202e"><B>h3.side-h "Schema"</B></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="310" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>dl.pol-schema#pol-schema</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="7" COLOR="#5b6672">dt = table name, dd = its columns<BR ALIGN="LEFT"/>laws (id, name, enacted, ended...)<BR ALIGN="LEFT"/>rulings (id, law_id, court, date...)<BR ALIGN="LEFT"/>breaches (id, service, accounts, when...)<BR ALIGN="LEFT"/>mono type; long column lists will wrap,<BR ALIGN="LEFT"/>so allow word-break inside the dd</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">p.side-note - SQLite on WebAssembly, built<BR ALIGN="LEFT"/>from JSON at build time, fetched once, then<BR ALIGN="LEFT"/>every query runs locally</FONT></TD></TR> </TABLE> </TD> </TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="10"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1030" BGCOLOR="#ffffff"> <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#14202e"><B>section.band - h2 "Five years of laws"</B> <FONT POINT-SIZE="9" COLOR="#5b6672">(the real-name rule)</FONT></FONT></TD></TR> <TR> <TD WIDTH="670" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="655" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#5b6672"><B>.band-main .prose - 3 paragraphs, ~70ch measure</B><BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P1 2007 identity verification above a traffic threshold<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P2 struck down 23 August 2012 [n] [n]<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P3 the 2011 Nate / Cyworld breach, 35m of 49m people<BR ALIGN="LEFT"/>_____________________________________________</FONT></TD></TR> </TABLE> </TD> <TD WIDTH="345" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="330" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#14202e"><B>aside - "Query it"</B></FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">points at the "Rulings joined to the law<BR ALIGN="LEFT"/>they concerned" preset<BR ALIGN="LEFT"/><FONT COLOR="#c04c4c">this asks the reader to scroll back up to<BR ALIGN="LEFT"/>the editor - an anchor link to #db-h, or a<BR ALIGN="LEFT"/>button that loads the preset and scrolls,<BR ALIGN="LEFT"/>would close the loop</FONT></FONT></TD></TR> </TABLE> </TD> </TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="10"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1030" BGCOLOR="#ffffff"> <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#14202e"><B>section.band - h2 "Decade of midnight"</B> <FONT POINT-SIZE="9" COLOR="#5b6672">(the Shutdown Law)</FONT></FONT></TD></TR> <TR> <TD WIDTH="670" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="655" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#5b6672"><B>.band-main .prose - 3 paragraphs</B><BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P1 curfew from 20 November 2011 [n]<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P2 mobile was never in scope, repealed 2021 [n] [n]<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P3 the PC bang restriction that outlived it [n]<BR ALIGN="LEFT"/>_____________________________________________</FONT></TD></TR> </TABLE> </TD> <TD WIDTH="345" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="330" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#14202e"><B>aside - "How long things lasted"</B></FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">explains the duration preset: computed<BR ALIGN="LEFT"/>from the enacted and ended columns, null<BR ALIGN="LEFT"/>end dates measured as still running</FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">p.side-note - the arithmetic happens inside<BR ALIGN="LEFT"/>SQLite in the browser, not in page JS</FONT></TD></TR> </TABLE> </TD> </TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="1060" BGCOLOR="#14202e"> <TR><TD CELLPADDING="12"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1030"> <TR> <TD WIDTH="515" VALIGN="TOP" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#ffffff"><B>.foot-col - p.foot-title site name</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="8" COLOR="#c9ced5">.foot-note - 20 years, 7 Oct 2006 to present</FONT></TD> <TD WIDTH="515" VALIGN="TOP" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#ffffff"><B>.foot-col - h2 "Sources on this page"</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="8" COLOR="#c9ced5">ol.cites#page-cites - columbia, koreaherald (x3), register,<BR ALIGN="LEFT"/>crafted. All sit in the prose bands, none in the database<BR ALIGN="LEFT"/>section; then a link to references.html</FONT></TD> </TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8" BGCOLOR="#0d1620"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" WIDTH="1030"> <TR> <TD ALIGN="LEFT" WIDTH="800"><FONT POINT-SIZE="8" COLOR="#9aa3ad">.foot-base - CM1040 Web Development, University of London, media credits</FONT></TD> <TD ALIGN="RIGHT" WIDTH="230"><FONT POINT-SIZE="8" COLOR="#9aa3ad">Back to top &#8593;</FONT></TD> </TR> </TABLE> </TD></TR> </TABLE> </TD></TR> </TABLE>>]; }
