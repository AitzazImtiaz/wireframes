digraph pcbang_laptop { graph [bgcolor="#ffffff", margin=0.25, label="pcbang.html | laptop", labelloc=t, labeljust=l, fontname="DejaVu Sans Bold", fontsize=17, fontcolor="#14202e"]; node [shape=plaintext, fontname="DejaVu Sans", fontsize=11]; page [label=< <TABLE BORDER="2" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#ffffff" WIDTH="1060"> <TR><TD ALIGN="LEFT" HEIGHT="24" BGCOLOR="#dde1e6"><FONT POINT-SIZE="9" COLOR="#5b6672"> viewport 1280 x 800 - a.skip then &lt;noscript&gt; - head &lt;style&gt; owns #room / .seat / .wire-log / .link-box / .bars</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="1060" HEIGHT="150" FIXEDSIZE="TRUE" BGCOLOR="#e4e8ec"> <TR><TD ALIGN="LEFT" VALIGN="BOTTOM" CELLPADDING="14"> <FONT POINT-SIZE="9" COLOR="#5b6672">header.hero - img.hero-img full bleed, .hero-text / .hero-inner overlay<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="9" COLOR="#2f5d8c">p.kicker KO (PC bang culture)<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="19" COLOR="#14202e"><B>h1 The Room After the Peak</B><BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="10" COLOR="#5b6672">p.sub 23,548 venues in 2001, under 7,000 now</FONT> </TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" WIDTH="1060" BGCOLOR="#f2f3f5" COLOR="#9aa3ad"> <TR> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Overview<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Timeline<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Network<BR/>KO</FONT></TD> <TD BGCOLOR="#14202e"><FONT POINT-SIZE="9" COLOR="#ffffff"><B>PC Bang</B><BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Culture<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Policy<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">References<BR/>KO</FONT></TD> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#5b6672">nav.topbar - 7 items, one row<BR/>aria-current="page" on PC Bang</FONT></TD> </TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="10"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1030" BGCOLOR="#ffffff"> <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#14202e"><B>section.band - h2 "Take a seat"</B> <FONT POINT-SIZE="9" COLOR="#5b6672">(the WebRTC demo)</FONT></FONT></TD></TR> <TR> <TD WIDTH="670" VALIGN="TOP"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" WIDTH="655"> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="655" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672"><B>p.tl-note</B> - the invitation: open this page in a second window or another device on the same network,<BR ALIGN="LEFT"/>follow the three steps in the aside, pick a seat and watch the other cursor. 4-5 lines.</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="2" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="655" HEIGHT="215" FIXEDSIZE="TRUE" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="CENTER" VALIGN="MIDDLE"><FONT POINT-SIZE="11" COLOR="#14202e"><B>svg#room viewBox 0 0 800 300 - the floor plan</B><BR/><FONT POINT-SIZE="9" COLOR="#5b6672">width 100%, height auto, role="img" + aria-label pointing at the seat table<BR/><BR/>g#seats - 24 rect.seat, built by pcbang.js, with .seat-n mono numbers<BR/>&nbsp;&nbsp;.seat = grey, .seat.mine = pine, .seat.theirs = hanbok red<BR/>g#ghosts - .ghost cursor markers for the peer, moved on pointermove<BR/><BR/>800:300 aspect, so at 655px it renders ~245px tall</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="655" HEIGHT="110" FIXEDSIZE="TRUE" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT" VALIGN="TOP" CELLPADDING="8"><FONT POINT-SIZE="9" COLOR="#14202e"><B>div.wire-log#log aria-live="polite"</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#5b6672">fixed height 120px, overflow-y: auto, mono 12px. Starts with one<BR ALIGN="LEFT"/>p.sys line: "Not connected. Nothing has left this browser."<BR ALIGN="LEFT"/>p.me = own lines (pine), p.sys = status lines (muted).<BR ALIGN="LEFT"/>Scroll it to the bottom on each new line, or messages hide below the fold.</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" WIDTH="655"> <TR> <TD WIDTH="540"> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="530" HEIGHT="34" FIXEDSIZE="TRUE" BGCOLOR="#f2f3f5"> <TR><TD ALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="8" COLOR="#5b6672"> input#say placeholder "say something across the room!" maxlength 80 <B>disabled</B></FONT></TD></TR> </TABLE> </TD> <TD WIDTH="115"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#f2f3f5"><TR><TD><FONT POINT-SIZE="8" COLOR="#9aa3ad">#send<BR/><B>disabled</B></FONT></TD></TR></TABLE> </TD> </TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">div.wire-say - flex row, gap 8px. Input and button both start disabled and are enabled only once the peer<BR ALIGN="LEFT"/>connection opens. label.sr-only "Message" is visually hidden but present for screen readers.</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="655" BGCOLOR="#f2f3f5"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#14202e">&#9656; details#graph-details / summary "Choose a seat without floor plan"</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#5b6672">collapsed by default. Open = table#graph-table, caption, columns: Seat | Row | Status<BR ALIGN="LEFT"/>tbody#seat-tbody from #tpl-seats - the Status cell holds a real button.linkish[data-seat],<BR ALIGN="LEFT"/>so this table is the keyboard route into the demo, not just a description of it</FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD> <TD WIDTH="345" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="330" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#14202e"><B>aside.band-side - "Connect two seats"</B></FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">explainer: WebRTC not HTTP, two browsers<BR ALIGN="LEFT"/>swap a code and talk directly, no server,<BR ALIGN="LEFT"/>works over LAN. 5-6 lines.</FONT></TD></TR> <TR><TD> <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="6" WIDTH="310" COLOR="#2f5d8c"> <TR> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#2f5d8c">#host<BR/>1 - Host</FONT></TD> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#2f5d8c">#join<BR/>1 - Join</FONT></TD> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#2f5d8c">#drop<BR/>Reset</FONT></TD> </TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#c04c4c">div.tl-bar - both Host and Join are labelled "1", which reads<BR ALIGN="LEFT"/>as a numbering slip; they are alternatives, not sequence</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="310" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e">div.link-box<BR ALIGN="LEFT"/><FONT POINT-SIZE="7" COLOR="#5b6672">LABEL: 2 - YOUR CODE, SEND IT OVER</FONT><BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="7" COLOR="#5b6672">textarea#mine readonly, h 64px, mono 11px<BR ALIGN="LEFT"/>placeholder "Press Host or Join first."</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="310" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e">div.link-box<BR ALIGN="LEFT"/><FONT POINT-SIZE="7" COLOR="#5b6672">LABEL: 3 - THEIR CODE, PASTE IT HERE</FONT><BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="7" COLOR="#5b6672">textarea#theirs h 64px, resize: vertical<BR ALIGN="LEFT"/>placeholder "Paste, then press Connect."</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" WIDTH="310" BGCOLOR="#ffffff"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9" COLOR="#2f5d8c"><B>#connect "Connect"</B></FONT></TD></TR></TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">p.side-note - a session description is<BR ALIGN="LEFT"/>kilobytes of text; &lt;code&gt;lz-string&lt;/code&gt;<BR ALIGN="LEFT"/>squeezes it to something pasteable</FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#c04c4c">the demo's controls live in the aside while its output lives<BR ALIGN="LEFT"/>in .band-main, so on a wide screen the reader works across<BR ALIGN="LEFT"/>both columns - keep the aside from getting taller than the plan</FONT></TD></TR> </TABLE> </TD> </TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="10"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1030" BGCOLOR="#ffffff"> <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#14202e"><B>section.band - h2 "Sixteen thousand rooms gone!"</B></FONT></TD></TR> <TR> <TD WIDTH="670" VALIGN="TOP"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" WIDTH="655"> <TR><TD> <TABLE BORDER="2" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="655" HEIGHT="170" FIXEDSIZE="TRUE" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="CENTER" VALIGN="MIDDLE"><FONT POINT-SIZE="11" COLOR="#14202e"><B>svg#chart.bars viewBox 0 0 800 320</B><BR/><FONT POINT-SIZE="9" COLOR="#5b6672">venue counts 1997 to 2025, peak 23,548 in 2001 down to 6,983<BR/>rect.bar (pine), .bar-l year labels, .bar-y value labels, both mono<BR/>drawn by pcbang.js; aria-label already carries the shape of the data<BR/><BR/>the aside repeats four of these numbers, so the chart carries the trend</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="655" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#5b6672"><B>div.prose - 3 paragraphs, nested inside .band-main after the chart</B><BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P1 100 venues in 1997 to the 2001 peak [n]<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P2 NTS and KOCCA counts, 10,568 to 6,983 [n] [n]<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P3 the caution: sources disagree on what counts as a venue<BR ALIGN="LEFT"/>_____________________________________________</FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD> <TD WIDTH="345" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="330" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#14202e"><B>aside - "The count"</B></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="310" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e">dl.scope - 4 dt/dd pairs, inline pairs<BR ALIGN="LEFT"/><B>1997</B> ~100 venues<BR ALIGN="LEFT"/><B>2001</B> 23,548 peak<BR ALIGN="LEFT"/><B>2017</B> 10,568<BR ALIGN="LEFT"/><B>2025</B> 6,983</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">p.side-note - ~70% fall in 25 years + [n]</FONT></TD></TR> </TABLE> </TD> </TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="10"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1030" BGCOLOR="#ffffff"> <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#14202e"><B>section.band - h2 "The rooms are closing. The business is growing."</B></FONT></TD></TR> <TR> <TD WIDTH="670" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="655" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#5b6672"><B>.band-main .prose - 4 paragraphs, the argument of the page</B><BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P1 revenue up 12.8% to ~2.26 trillion won [n]<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P2 consolidation, upgrade rates [n]<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P3 they were never selling internet access<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P4 why the demo is a floor plan - ties back to section 1<BR ALIGN="LEFT"/>_____________________________________________</FONT></TD></TR> </TABLE> </TD> <TD WIDTH="345" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="330" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#14202e"><B>aside - "2024 in one line"</B></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="310" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e">dl.scope - 3 dt/dd pairs<BR ALIGN="LEFT"/><B>Revenue</B> ~2.26 trillion won, up 12.8%<BR ALIGN="LEFT"/><B>Venues</B> 7,243, down 530 in a year<BR ALIGN="LEFT"/><B>Hourly rate</B> 1,246 / 1,459 won</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">p.side-note - prices flat since the late<BR ALIGN="LEFT"/>1990s + [n]</FONT></TD></TR> </TABLE> </TD> </TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="1060" BGCOLOR="#14202e"> <TR><TD CELLPADDING="12"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1030"> <TR> <TD WIDTH="515" VALIGN="TOP" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#ffffff"><B>.foot-col - p.foot-title site name</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="8" COLOR="#c9ced5">.foot-note - 20 years, 7 Oct 2006 to present</FONT></TD> <TD WIDTH="515" VALIGN="TOP" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#ffffff"><B>.foot-col - h2 "Sources on this page"</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="8" COLOR="#c9ced5">ol.cites#page-cites - crafted, asiae, epickor,<BR ALIGN="LEFT"/>each cited more than once above, so refs.js has to<BR ALIGN="LEFT"/>de-duplicate; then a link to references.html</FONT></TD> </TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8" BGCOLOR="#0d1620"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" WIDTH="1030"> <TR> <TD ALIGN="LEFT" WIDTH="800"><FONT POINT-SIZE="8" COLOR="#9aa3ad">.foot-base - CM1040 Web Development, University of London, media credits</FONT></TD> <TD ALIGN="RIGHT" WIDTH="230"><FONT POINT-SIZE="8" COLOR="#9aa3ad">Back to top &#8593;</FONT></TD> </TR> </TABLE> </TD></TR> </TABLE> </TD></TR> </TABLE>>]; }
