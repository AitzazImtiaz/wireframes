digraph pcbang_mobile { graph [bgcolor="#ffffff", margin=0.25, label="pcbang.html | mobile", labelloc=t, labeljust=l, fontname="DejaVu Sans Bold", fontsize=17, fontcolor="#14202e"]; node [shape=plaintext, fontname="DejaVu Sans", fontsize=11]; phone [label=< <TABLE BORDER="3" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#ffffff" WIDTH="380"> <TR><TD ALIGN="CENTER" HEIGHT="22" BGCOLOR="#14202e"><FONT POINT-SIZE="8" COLOR="#ffffff">status bar - viewport 390 x 844, single column, page scrolls</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="374" HEIGHT="140" FIXEDSIZE="TRUE" BGCOLOR="#e4e8ec"> <TR><TD ALIGN="LEFT" VALIGN="BOTTOM" CELLPADDING="8"> <FONT POINT-SIZE="7" COLOR="#5b6672">header.hero - img object-fit: cover, ~35-40vh<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="8" COLOR="#2f5d8c">p.kicker KO<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="13" COLOR="#14202e"><B>h1 The Room After<BR ALIGN="LEFT"/>the Peak</B><BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="8" COLOR="#5b6672">p.sub wraps to 2-3 lines</FONT> </TD></TR> </TABLE> </TD></TR> <TR><TD BGCOLOR="#f2f3f5" CELLPADDING="0"> <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" WIDTH="374" COLOR="#9aa3ad"> <TR> <TD><FONT POINT-SIZE="8" COLOR="#14202e">Overview<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="8" COLOR="#14202e">Timeline<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="8" COLOR="#14202e">Network<BR/>KO</FONT></TD> <TD BGCOLOR="#14202e"><FONT POINT-SIZE="8" COLOR="#ffffff"><B>PC Bang</B><BR/>KO</FONT></TD> <TD BGCOLOR="#e4e8ec"><FONT POINT-SIZE="12" COLOR="#5b6672">&#8250;</FONT></TD> </TR> <TR><TD COLSPAN="5" BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#5b6672">nav.topbar - scroll strip; Culture / Policy / References off-screen right</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="358"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#14202e"><B>h2 Take a seat</B></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672"><B>p.tl-note</B> - invitation, 6-8 lines here.<BR ALIGN="LEFT"/><FONT COLOR="#c04c4c">"open a second browser window" is awkward<BR ALIGN="LEFT"/>on a phone - the realistic pairing is phone<BR ALIGN="LEFT"/>plus laptop, so say that in the mobile copy.</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="2" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="344" HEIGHT="145" FIXEDSIZE="TRUE" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="CENTER" VALIGN="MIDDLE"><FONT POINT-SIZE="9" COLOR="#14202e"><B>svg#room (g#seats + g#ghosts)</B><BR/><FONT POINT-SIZE="7" COLOR="#5b6672">800:300 viewBox scales to ~344 x 129px<BR/><BR/>24 seats across 344px is roughly 40px per seat<BR/>before gaps, so .seat-n mono 9px labels stop<BR/>being legible and taps land between seats.<BR/>Either reflow the plan to fewer seats per row<BR/>(a 4 x 6 grid) or treat the seat table below as<BR/>the primary picker on small screens.<BR/>g#ghosts tracks pointermove - there is no<BR/>hover cursor on touch, so ghosts only appear<BR/>while a finger is down.</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="344" HEIGHT="95" FIXEDSIZE="TRUE" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT" VALIGN="TOP" CELLPADDING="6"><FONT POINT-SIZE="8" COLOR="#14202e"><B>div.wire-log#log</B> aria-live<BR ALIGN="LEFT"/><FONT POINT-SIZE="7" COLOR="#5b6672">height stays 120px, mono 12px, own scrollbar.<BR ALIGN="LEFT"/>p.sys "Not connected. Nothing has left<BR ALIGN="LEFT"/>this browser."<BR ALIGN="LEFT"/>A nested scroll area inside a scrolling page is<BR ALIGN="LEFT"/>awkward on touch - consider letting it grow.</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" WIDTH="344"> <TR> <TD WIDTH="250"> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="240" HEIGHT="40" FIXEDSIZE="TRUE" BGCOLOR="#f2f3f5"> <TR><TD ALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="7" COLOR="#5b6672"> input#say disabled<BR ALIGN="LEFT"/> mono 12px - raise to 16px</FONT></TD></TR> </TABLE> </TD> <TD WIDTH="94"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#f2f3f5"><TR><TD><FONT POINT-SIZE="8" COLOR="#9aa3ad">#send</FONT></TD></TR></TABLE> </TD> </TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#5b6672">div.wire-say - flex row survives at this width (input has flex: 1, min-width: 0).<BR ALIGN="LEFT"/>The keyboard will cover the log, so scroll the newest line into view on send.</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="344" BGCOLOR="#f2f3f5"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e">&#9656; "Choose a seat without floor plan"<BR ALIGN="LEFT"/><FONT COLOR="#5b6672">Seat | Row | Status, from #tpl-seats.<BR ALIGN="LEFT"/>Each row holds a "Take this seat" button, so<BR ALIGN="LEFT"/>this is the reliable picker here - consider<BR ALIGN="LEFT"/>open by default below 560px. 24 rows means<BR ALIGN="LEFT"/>a long list; 44px per row.</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#14202e"><B>aside.band-side "Connect two seats"</B> (below)</FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">WebRTC explainer, 8-10 lines at this width</FONT></TD></TR> <TR><TD> <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="8" WIDTH="330" COLOR="#2f5d8c"> <TR> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#2f5d8c">Host</FONT></TD> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#2f5d8c">Join</FONT></TD> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#2f5d8c">Reset</FONT></TD> </TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="330" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#5b6672">2 - YOUR CODE, SEND IT OVER<BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="8" COLOR="#14202e">textarea#mine readonly, 64px<BR ALIGN="LEFT"/><FONT POINT-SIZE="7" COLOR="#c04c4c">needs a Copy button here - selecting<BR ALIGN="LEFT"/>a long mono blob by touch is painful</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="330" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#5b6672">3 - THEIR CODE, PASTE IT HERE<BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="8" COLOR="#14202e">textarea#theirs, 64px, resize: vertical</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" WIDTH="330" BGCOLOR="#ffffff"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9" COLOR="#2f5d8c"><B>#connect "Connect" (full width)</B></FONT></TD></TR></TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">p.side-note - lz-string squeezes the<BR ALIGN="LEFT"/>session description</FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#c04c4c">stacking puts the three steps BELOW the floor plan and the<BR ALIGN="LEFT"/>log they control, so a first-time reader meets the output<BR ALIGN="LEFT"/>before the instructions. Consider moving this aside above<BR ALIGN="LEFT"/>the svg on small screens.</FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="358"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#14202e"><B>h2 Sixteen thousand<BR ALIGN="LEFT"/>rooms gone!</B></FONT></TD></TR> <TR><TD> <TABLE BORDER="2" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="344" HEIGHT="115" FIXEDSIZE="TRUE" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="CENTER" VALIGN="MIDDLE"><FONT POINT-SIZE="9" COLOR="#14202e"><B>svg#chart.bars</B><BR/><FONT POINT-SIZE="7" COLOR="#5b6672">800:320 scales to ~344 x 138px<BR/>.bar-l year labels at 10px will collide across<BR/>~29 years - label every 5th bar, or rotate them.<BR/>.bar-y value labels probably have to go.</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672"><B>div.prose</B> - after the chart<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P1 1997 to the 2001 peak [1]<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P2 NTS / KOCCA counts [2] [3]<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P3 sources disagree</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>aside "The count"</B> - dl.scope<BR ALIGN="LEFT"/>1997 / ~100 · 2001 / 23,548 peak<BR ALIGN="LEFT"/>2017 / 10,568 · 2025 / 6,983<BR ALIGN="LEFT"/><FONT COLOR="#5b6672">2-up pairs work well here; the note<BR ALIGN="LEFT"/>duplicates the chart, so it is the<BR ALIGN="LEFT"/>fallback if the svg is illegible</FONT></FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="358"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#14202e"><B>h2 The rooms are closing.<BR ALIGN="LEFT"/>The business is growing.</B></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672"><B>.band-main .prose</B> - 4 paragraphs<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P1 revenue up 12.8% [1]<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P2 consolidation, upgrades [3]<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P3 never selling access<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P4 why a floor plan</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>aside "2024 in one line"</B><BR ALIGN="LEFT"/>Revenue / ~2.26tn won, up 12.8%<BR ALIGN="LEFT"/>Venues / 7,243, down 530<BR ALIGN="LEFT"/>Hourly rate / 1,246 or 1,459 won<BR ALIGN="LEFT"/><FONT COLOR="#5b6672">p.side-note prices flat since 1990s [3]</FONT></FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD></TR> <TR><TD BGCOLOR="#14202e" CELLPADDING="10"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="354"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#ffffff"><B>A History of the Internet<BR ALIGN="LEFT"/>in South Korea</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#c9ced5">p.foot-note</FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#ffffff"><B>Sources on this page</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#c9ced5">ol.cites#page-cites<BR ALIGN="LEFT"/>1. crafted 2. asiae 3. epickor<BR ALIGN="LEFT"/>Full reference list &#8594;</FONT></TD></TR> <TR><TD ALIGN="LEFT" BGCOLOR="#0d1620"><FONT POINT-SIZE="7" COLOR="#9aa3ad">CM1040 - University of London<BR ALIGN="LEFT"/>Back to top &#8593;</FONT></TD></TR> <TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#5b6672">.foot-grid 2 cols becomes stacked</FONT></TD></TR> </TABLE> </TD></TR> </TABLE>>]; }
