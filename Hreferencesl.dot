digraph references_laptop { graph [bgcolor="#ffffff", margin=0.25, label="references.html | laptop", labelloc=t, labeljust=l, fontname="DejaVu Sans Bold", fontsize=17, fontcolor="#14202e"]; node [shape=plaintext, fontname="DejaVu Sans", fontsize=11]; page [label=< <TABLE BORDER="2" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#ffffff" WIDTH="1060"> <TR><TD ALIGN="LEFT" HEIGHT="34" BGCOLOR="#dde1e6"><FONT POINT-SIZE="9" COLOR="#5b6672"> viewport 1280 x 800 - a.skip only: this page has NO &lt;noscript&gt; block, yet #ref-list is JS-only, so with JS off the reader<BR ALIGN="LEFT"/> gets a heading, a paragraph and an empty page. Also no &lt;meta name="description"&gt;, and &lt;main id="app"&gt; has no tabindex="-1".</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="1060" HEIGHT="150" FIXEDSIZE="TRUE" BGCOLOR="#e4e8ec"> <TR><TD ALIGN="LEFT" VALIGN="BOTTOM" CELLPADDING="14"> <FONT POINT-SIZE="9" COLOR="#5b6672">header.hero - img.hero-img full bleed, .hero-text / .hero-inner overlay<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="9" COLOR="#2f5d8c">p.kicker KO (references)<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="19" COLOR="#14202e"><B>h1 Sources and Credits</B><BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="10" COLOR="#5b6672">p.sub every fact, image and dataset used on this site</FONT> </TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" WIDTH="1060" BGCOLOR="#f2f3f5" COLOR="#9aa3ad"> <TR> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Overview<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Timeline<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Network<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">PC Bang<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Culture<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Policy<BR/>KO</FONT></TD> <TD BGCOLOR="#14202e"><FONT POINT-SIZE="9" COLOR="#ffffff"><B>References</B><BR/>KO</FONT></TD> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#5b6672">nav.topbar - 7 items, one row<BR/>aria-current="page" on References</FONT></TD> </TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="10"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="1030" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#14202e"><B>article#main - h2 "Sources"</B> <FONT POINT-SIZE="9" COLOR="#c04c4c">no section.band and no aside on this page, so the content is<BR ALIGN="LEFT"/>one full-bleed column: it will run the entire 1030px unless you give it a max-width (~70ch) or reuse .band</FONT></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1010" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#5b6672">p - one intro paragraph: this page lists every reference and links back to where each is used<BR ALIGN="LEFT"/>_________________________________________________________________________________________</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="2" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1010" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#14202e"><B>div#ref-list</B> - empty in the HTML, built entirely by assets/js/refs.js from the shared JSON</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" WIDTH="990" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#14202e"><B>[1]</B> Author / publisher, title, year<BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#2f5d8c">https://... (the link is the only interactive element on the page)<BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="8" COLOR="#5b6672">used on: Overview, Network - back-links, since the intro promises the list<BR ALIGN="LEFT"/>"connects with all the locations where references are made"</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" WIDTH="990" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#14202e"><B>[2]</B> ______________________________________<BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#5b6672">one row per reference, repeated for every entry in the JSON</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" WIDTH="990" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#14202e"><B>[3]</B> ______________________________________</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" WIDTH="990" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#14202e"><B>[4]</B> ______________________________________</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">... every ref used across the site (apnic, reuters, koreaherald, datareportal, akamai, abs-oecd, kedglobal,<BR ALIGN="LEFT"/>techcrunch, bloomberg, crafted, asiae, epickor, columbia, register, and the media credits). Roughly 15-20 rows.</FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#c04c4c">worth adding: an ordered list rather than plain divs so the numbering is semantic, a stable id per entry so<BR ALIGN="LEFT"/>inline [n] chips on other pages can deep-link here, and a visible loading or empty state while the JSON fetches.</FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">the page title also breaks the site pattern - every other page uses a bare title, this one uses<BR ALIGN="LEFT"/>"References - A History of the Internet in South Korea"</FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="1060" BGCOLOR="#14202e"> <TR><TD CELLPADDING="12"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1030"> <TR> <TD WIDTH="515" VALIGN="TOP" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#ffffff"><B>.foot-col - p.foot-title site name</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="8" COLOR="#c9ced5">.foot-note - 20 years, 7 Oct 2006 to present</FONT></TD> <TD WIDTH="515" VALIGN="TOP" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#ffffff"><B>.foot-col - h2 "About the sources"</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="8" COLOR="#c9ced5">the only page where this column is PROSE, not ol.cites#page-cites:<BR ALIGN="LEFT"/>a p.foot-note on preferring KISA and MSIT over secondary reporting.<BR ALIGN="LEFT"/>No "Full reference list" link either, since this IS that page.</FONT></TD> </TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8" BGCOLOR="#0d1620"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" WIDTH="1030"> <TR> <TD ALIGN="LEFT" WIDTH="800"><FONT POINT-SIZE="8" COLOR="#9aa3ad">.foot-base - CM1040 Web Development, University of London, media credits</FONT></TD> <TD ALIGN="RIGHT" WIDTH="230"><FONT POINT-SIZE="8" COLOR="#9aa3ad">Back to top &#8593;</FONT></TD> </TR> </TABLE> </TD></TR> </TABLE> </TD></TR> </TABLE>>]; }
