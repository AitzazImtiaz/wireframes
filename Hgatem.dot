digraph gate_mobile { graph [bgcolor="#ffffff", margin=0.25, label="gate.html | mobile", labelloc=t, labeljust=l, fontname="DejaVu Sans Bold", fontsize=17, fontcolor="#14202e"]; node [shape=plaintext, fontname="DejaVu Sans", fontsize=11]; phone [label=< <TABLE BORDER="3" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#eef0f3" WIDTH="380"> <TR><TD ALIGN="CENTER" HEIGHT="22" BGCOLOR="#14202e"><FONT POINT-SIZE="8" COLOR="#ffffff">status bar / notch - viewport 390 x 844</FONT></TD></TR> <TR><TD CELLPADDING="8"> <TABLE BORDER="2" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#ffffff" WIDTH="356"> <TR><TD ALIGN="LEFT" CELLPADDING="8"><FONT POINT-SIZE="8" COLOR="#2f5d8c">.eyebrow "Local verification :D"</FONT></TD></TR> <TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="13" COLOR="#14202e"><B>h2.title<BR ALIGN="LEFT"/>"Solve this challenge!"</B></FONT></TD></TR> <TR><TD CELLPADDING="6"> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="330" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">p.lede wraps to 4-5 lines here.<BR ALIGN="LEFT"/>Keep font-size 15-16px so it stays<BR ALIGN="LEFT"/>readable without zoom.</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="6"> <TABLE BORDER="2" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="330" BGCOLOR="#f2f6fb"> <TR><TD CELLPADDING="5"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" WIDTH="318"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e">#plate-id "plate 000"</FONT></TD></TR> <TR><TD ALIGN="LEFT"> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD><FONT POINT-SIZE="8" COLOR="#2f5d8c">#refresh "New plate" (44px tap target)</FONT></TD></TR></TABLE> </TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="5"> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="318" HEIGHT="86" FIXEDSIZE="TRUE" BGCOLOR="#ffffff"> <TR><TD ALIGN="CENTER" VALIGN="MIDDLE"><FONT POINT-SIZE="9" COLOR="#14202e"><B>&lt;canvas id="plate"&gt;</B><BR/><FONT POINT-SIZE="8" COLOR="#5b6672">width: 100% of card, height ~80-92px.<BR/>clientWidth drives draw() so it must be<BR/>fluid; re-drawn on rotate (resize).</FONT></FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="6"> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" WIDTH="330"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#2f5d8c">#toggle-alt "Quick Maths" - full width on mobile</FONT></TD></TR></TABLE> </TD></TR> <TR><TD CELLPADDING="6"> <TABLE BORDER="1" COLOR="#b9c0c8" STYLE="DASHED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="330" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672"><B>#alt-box (hidden)</B><BR ALIGN="LEFT"/>#alt-q spelled-out sum. Set input<BR ALIGN="LEFT"/>type/inputmode=numeric here so the<BR ALIGN="LEFT"/>digit keypad opens.</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="6"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" WIDTH="330"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e">label "Your answer"</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="330" HEIGHT="44" FIXEDSIZE="TRUE" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT" VALIGN="MIDDLE"><FONT POINT-SIZE="8" COLOR="#5b6672"> input#answer - 16px font min<BR ALIGN="LEFT"/> (stops iOS auto-zoom)</FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="6"> <TABLE BORDER="1" COLOR="#c04c4c" STYLE="DASHED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" WIDTH="330"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#c04c4c">#hp-city honeypot - zero height, never visible</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="6"> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="330" HEIGHT="48" FIXEDSIZE="TRUE" BGCOLOR="#14202e"> <TR><TD ALIGN="CENTER" VALIGN="MIDDLE"><FONT POINT-SIZE="10" COLOR="#ffffff"><B>#verify "Verify" (full width)</B></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="8" COLOR="#5b6672">#gate-msg role="status"<BR ALIGN="LEFT"/>reserve ~2 lines of height so the card<BR ALIGN="LEFT"/>does not jump when an error appears</FONT></TD></TR> <TR><TD ALIGN="LEFT" CELLPADDING="8" BGCOLOR="#f2f3f5"><FONT POINT-SIZE="7" COLOR="#5b6672">p.credit - art credit, 2 lines</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD ALIGN="CENTER" HEIGHT="20" BGCOLOR="#dde1e6"><FONT POINT-SIZE="7" COLOR="#5b6672">page scrolls - card is taller than one screen</FONT></TD></TR> </TABLE>>]; }
