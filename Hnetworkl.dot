digraph network_laptop { graph [bgcolor="#ffffff", margin=0.25, label="network.html | laptop", labelloc=t, labeljust=l, fontname="DejaVu Sans Bold", fontsize=17, fontcolor="#14202e"]; node [shape=plaintext, fontname="DejaVu Sans", fontsize=11]; page [label=< <TABLE BORDER="2" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#ffffff" WIDTH="1060"> <TR><TD ALIGN="LEFT" HEIGHT="24" BGCOLOR="#dde1e6"><FONT POINT-SIZE="9" COLOR="#5b6672"> viewport 1280 x 800 - no gate on this page, #app renders immediately - a.skip then &lt;noscript&gt; sit above the hero</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="1060" HEIGHT="150" FIXEDSIZE="TRUE" BGCOLOR="#e4e8ec"> <TR><TD ALIGN="LEFT" VALIGN="BOTTOM" CELLPADDING="14"> <FONT POINT-SIZE="9" COLOR="#5b6672">header.hero - img.hero-img full bleed (header.jpg, same asset as Overview), .hero-text overlay<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="9" COLOR="#2f5d8c">p.kicker KO (infra)<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="19" COLOR="#14202e"><B>h1 Wires, Exchanges, Cables</B><BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="10" COLOR="#5b6672">p.sub three operators, a handful of exchanges, nine cables</FONT> </TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" WIDTH="1060" BGCOLOR="#f2f3f5" COLOR="#9aa3ad"> <TR> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Overview<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Timeline<BR/>KO</FONT></TD> <TD BGCOLOR="#14202e"><FONT POINT-SIZE="9" COLOR="#ffffff"><B>Network</B><BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">PC Bang<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Culture<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Policy<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">References<BR/>KO</FONT></TD> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#5b6672">nav.topbar - 7 items, one row<BR/>aria-current="page" on Network</FONT></TD> </TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="10"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1030" BGCOLOR="#ffffff"> <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#14202e"><B>section.band - h2 "The Network Mapped (Revisited!)"</B></FONT></TD></TR> <TR> <TD WIDTH="670" VALIGN="TOP"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" WIDTH="655"> <TR><TD> <TABLE BORDER="1" COLOR="#c04c4c" STYLE="DASHED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" WIDTH="655"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#c04c4c">#graph-error [hidden] role="alert" - only paints if data/network.json fails to load</FONT></TD></TR></TABLE> </TD></TR> <TR><TD> <TABLE BORDER="2" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="655" HEIGHT="260" FIXEDSIZE="TRUE" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="CENTER" VALIGN="MIDDLE"><FONT POINT-SIZE="11" COLOR="#14202e"><B>div#cy - Cytoscape canvas</B><BR/><FONT POINT-SIZE="9" COLOR="#5b6672">width: 100%, height: 520px (inline &lt;style&gt; in the head)<BR/>role="img" + aria-label describing the 10 organisations<BR/><BR/>10 draggable nodes, 4 type colours (isp / ix / academic / cable)<BR/>edge weights: solid peer, thick backbone, dashed cable landing<BR/>pan + zoom on background drag, click a node to fill #net-detail</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" WIDTH="655" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#14202e"><B>div#net-detail .tl-detail aria-live="polite"</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#5b6672">empty on load, then #tpl-net-detail writes p.tl-when (type) + h3.tl-title (name) + p.tl-note.<BR ALIGN="LEFT"/>Give it a min-height so the map and table below do not jump on first click.</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="655" BGCOLOR="#f2f3f5"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#14202e">&#9656; details#graph-details / summary "View this data as table"</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#5b6672">collapsed by default. Open = table#graph-table with caption (holds a link to data/network.json)<BR ALIGN="LEFT"/>and 4 columns: Name | Type | Connects to | Since - tbody#net-tbody from #tpl-net-rows</FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD> <TD WIDTH="345" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="330" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#14202e"><B>aside.band-side - h3.side-h "Using this!"</B></FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">instructions paragraph: drag a node,<BR ALIGN="LEFT"/>drag background to pan/zoom, click for<BR ALIGN="LEFT"/>detail, table below is the fallback</FONT></TD></TR> <TR><TD> <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="6" WIDTH="310" COLOR="#2f5d8c"> <TR> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#2f5d8c">#net-preset<BR/>"Map"</FONT></TD> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#2f5d8c">#net-circle<BR/>"Circle"</FONT></TD> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#2f5d8c">#net-fit<BR/>"Fit"</FONT></TD> </TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">div.tl-bar - 3 .linkish layout buttons in a row</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="310" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e">ul.graph-key - 4 rows, i swatch + label<BR ALIGN="LEFT"/>&#9679; Internet provider<BR ALIGN="LEFT"/>&#9679; Exchange point<BR ALIGN="LEFT"/>&#9679; Research network<BR ALIGN="LEFT"/>&#9679; Submarine cable</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">p.side-note - line styles: solid peer,<BR ALIGN="LEFT"/>thick backbone, dashed cable landing</FONT></TD></TR> </TABLE> </TD> </TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="10"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1030" BGCOLOR="#ffffff"> <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#14202e"><B>section.band - h2 "Who owns the wires?"</B></FONT></TD></TR> <TR> <TD WIDTH="670" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="655" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#5b6672"><B>.band-main .prose - 3 paragraphs, ~70ch measure</B><BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P1 the three-operator split, KT 41% [n]<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P2 the Oct 2021 KT routing outage [n] [n]<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P3 why peering disputes matter, inline link to Culture<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>inline &lt;cite data-ref&gt; render as [1] [2] chips via refs.js</FONT></TD></TR> </TABLE> </TD> <TD WIDTH="345" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="330" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#14202e"><B>aside - "Market share, 2023"</B></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="310" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e">dl.scope - 3 dt/dd pairs<BR ALIGN="LEFT"/><B>KT</B> ~41% - 9.8m<BR ALIGN="LEFT"/><B>SK Broadband</B> ~29% - 6.8m<BR ALIGN="LEFT"/><B>LG U+</B> ~21% - 5.1m</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">p.side-note - APNIC attribution + [n]</FONT></TD></TR> </TABLE> </TD> </TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="10"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1030" BGCOLOR="#ffffff"> <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#14202e"><B>section.band - h2 "Where traffic meets"</B></FONT></TD></TR> <TR> <TD WIDTH="670" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="655" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#5b6672"><B>.band-main .prose - 3 paragraphs</B><BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P1 pre-1995 Pacific round trips, first domestic IX<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P2 KINX formed June 1999 by sixteen members<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P3 five exchanges, nine cables, four landing stations [n]<BR ALIGN="LEFT"/>_____________________________________________</FONT></TD></TR> </TABLE> </TD> <TD WIDTH="345" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="330" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#14202e"><B>aside - "But why neutrality matters?"</B></FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">paragraph 1 - carrier-run exchange<BR ALIGN="LEFT"/>vs rival traffic, the case for a<BR ALIGN="LEFT"/>settlement-free neutral exchange<BR ALIGN="LEFT"/>___________________________<BR ALIGN="LEFT"/>___________________________</FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">p.side-note - KINX, sole neutral<BR ALIGN="LEFT"/>exchange since 1999</FONT></TD></TR> </TABLE> </TD> </TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="10"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1030" BGCOLOR="#ffffff"> <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#14202e"><B>section.band - h2 "Fast, as said, no longer exceptional"</B></FONT></TD></TR> <TR> <TD WIDTH="670" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="655" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#5b6672"><B>.band-main .prose - 3 paragraphs</B><BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P1 2006 OECD lead, 2011 Akamai peak [n] [n]<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P2 233 Mbps median, relative slide [n]<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P3 closing argument, hands off to platform / policy / culture<BR ALIGN="LEFT"/>_____________________________________________</FONT></TD></TR> </TABLE> </TD> <TD WIDTH="345" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="330" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#14202e"><B>aside - "Then and now"</B></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="310" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e">dl.scope - 3 dt/dd pairs<BR ALIGN="LEFT"/><B>2006</B> 94% of households [n]<BR ALIGN="LEFT"/><B>2011</B> 17.5 Mbps, fastest [n]<BR ALIGN="LEFT"/><B>2025</B> 233 Mbps, 97.2% online [n]</FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD> </TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="1060" BGCOLOR="#14202e"> <TR><TD CELLPADDING="12"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1030"> <TR> <TD WIDTH="515" VALIGN="TOP" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#ffffff"><B>.foot-col - p.foot-title site name</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="8" COLOR="#c9ced5">.foot-note - 20 years, 7 Oct 2006 to present</FONT></TD> <TD WIDTH="515" VALIGN="TOP" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#ffffff"><B>.foot-col - h2 "Sources on this page"</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="8" COLOR="#c9ced5">ol.cites#page-cites - refs.js swaps the placeholder for the<BR ALIGN="LEFT"/>numbered refs actually cited above (apnic, reuters, koreaherald,<BR ALIGN="LEFT"/>abs-oecd, akamai, datareportal) then a link to references.html</FONT></TD> </TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8" BGCOLOR="#0d1620"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" WIDTH="1030"> <TR> <TD ALIGN="LEFT" WIDTH="800"><FONT POINT-SIZE="8" COLOR="#9aa3ad">.foot-base - CM1040 Web Development, University of London, media credits</FONT></TD> <TD ALIGN="RIGHT" WIDTH="230"><FONT POINT-SIZE="8" COLOR="#9aa3ad">Back to top &#8593;</FONT></TD> </TR> </TABLE> </TD></TR> </TABLE> </TD></TR> </TABLE>>]; }
