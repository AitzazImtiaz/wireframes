digraph policy_mobile { graph [bgcolor="#ffffff", margin=0.25, label="policy.html | mobile", labelloc=t, labeljust=l, fontname="DejaVu Sans Bold", fontsize=17, fontcolor="#14202e"]; node [shape=plaintext, fontname="DejaVu Sans", fontsize=11]; phone [label=< <TABLE BORDER="3" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#ffffff" WIDTH="380"> <TR><TD ALIGN="CENTER" HEIGHT="22" BGCOLOR="#14202e"><FONT POINT-SIZE="8" COLOR="#ffffff">status bar - viewport 390 x 844, single column, page scrolls</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="374" HEIGHT="140" FIXEDSIZE="TRUE" BGCOLOR="#e4e8ec"> <TR><TD ALIGN="LEFT" VALIGN="BOTTOM" CELLPADDING="8"> <FONT POINT-SIZE="7" COLOR="#5b6672">header.hero - img object-fit: cover, ~35-40vh<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="8" COLOR="#2f5d8c">p.kicker KO<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="13" COLOR="#14202e"><B>h1 Rules; Rulings;<BR ALIGN="LEFT"/>Records</B><BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="8" COLOR="#5b6672">p.sub wraps to 2 lines</FONT> </TD></TR> </TABLE> </TD></TR> <TR><TD BGCOLOR="#f2f3f5" CELLPADDING="0"> <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" WIDTH="374" COLOR="#9aa3ad"> <TR> <TD><FONT POINT-SIZE="8" COLOR="#14202e">Network<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="8" COLOR="#14202e">PC Bang<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="8" COLOR="#14202e">Culture<BR/>KO</FONT></TD> <TD BGCOLOR="#14202e"><FONT POINT-SIZE="8" COLOR="#ffffff"><B>Policy</B><BR/>KO</FONT></TD> <TD BGCOLOR="#e4e8ec"><FONT POINT-SIZE="12" COLOR="#5b6672">&#8250;</FONT></TD> </TR> <TR><TD COLSPAN="5" BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#5b6672">nav.topbar - scroll strip, current item scrolled into view; Overview / Timeline off-screen left</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="358"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#14202e"><B>h2 Ask the database</B></FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>div.pol-grid</B> <FONT POINT-SIZE="7" COLOR="#5b6672">- collapses to one column</FONT></FONT></TD></TR> <TR><TD> <TABLE BORDER="2" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="344" HEIGHT="120" FIXEDSIZE="TRUE" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="CENTER" VALIGN="MIDDLE"><FONT POINT-SIZE="9" COLOR="#14202e"><B>div#pol-editor</B><BR/><FONT POINT-SIZE="7" COLOR="#5b6672">a code editor on a 344px screen: SQL lines wrap<BR/>or scroll sideways, and the software keyboard has<BR/>no easy path to * ( ); or quotes.<BR/><BR/>Presets carry the weight here - keep the editor<BR/>editable but expect most readers to run a preset.<BR/>Set the font to 16px so focus does not zoom the<BR/>viewport, and cap the height (~6 rows) so Run<BR/>stays reachable.</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" WIDTH="344"> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" WIDTH="344" BGCOLOR="#14202e"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10" COLOR="#ffffff"><B>#pol-run "Run" (full width, 44px)</B></FONT></TD></TR></TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#5b6672">p.pol-note#pol-note - "Loading..." then the status line.<BR ALIGN="LEFT"/>div.pol-bar stacks button over note at this width.</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="344" HEIGHT="125" FIXEDSIZE="TRUE" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT" VALIGN="TOP" CELLPADDING="6"><FONT POINT-SIZE="8" COLOR="#14202e"><B>div#pol-out</B> role="region" aria-live<BR ALIGN="LEFT"/><FONT POINT-SIZE="7" COLOR="#5b6672">_______________________________<BR ALIGN="LEFT"/>_______________________________<BR ALIGN="LEFT"/>_______________________________<BR ALIGN="LEFT"/><FONT COLOR="#c04c4c">a multi-column result will not fit 344px.<BR ALIGN="LEFT"/>Wrap it in overflow-x: auto with a visible<BR ALIGN="LEFT"/>edge, or render each row as a stacked<BR ALIGN="LEFT"/>label/value block. Scroll it into view after<BR ALIGN="LEFT"/>Run - otherwise the keyboard hides the result.</FONT></FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#14202e"><B>aside.band-side</B> (below the whole tool)</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="330" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>h3 "Try one" + div#pol-presets</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="7" COLOR="#5b6672">[ Rulings joined to the law ... ]<BR ALIGN="LEFT"/>[ How long each law lasted ]<BR ALIGN="LEFT"/>[ Breaches by year ]<BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#c04c4c">these are the main input on mobile, so<BR ALIGN="LEFT"/>they belong ABOVE the editor here -<BR ALIGN="LEFT"/>full-width buttons, 44px tall</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="330" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>h3 "Schema" + dl.pol-schema#pol-schema</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="7" COLOR="#5b6672">laws (id, name, enacted, ended...)<BR ALIGN="LEFT"/>rulings (id, law_id, court, date...)<BR ALIGN="LEFT"/>breaches (id, service, accounts...)<BR ALIGN="LEFT"/>mono column lists overflow - allow<BR ALIGN="LEFT"/>word-break, or make this a details toggle</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">p.side-note - SQLite on wasm, fetched once,<BR ALIGN="LEFT"/>queries run locally<BR ALIGN="LEFT"/><FONT COLOR="#c04c4c">worth noting the download size: a wasm<BR ALIGN="LEFT"/>binary plus the database on mobile data</FONT></FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="358"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#14202e"><B>h2 Five years of laws</B></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672"><B>.band-main .prose</B> (1st in flow)<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P1 2007 real-name verification<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P2 struck down Aug 2012 [1] [2]<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P3 the 2011 Nate / Cyworld breach</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>aside "Query it"</B><BR ALIGN="LEFT"/><FONT COLOR="#5b6672">names a preset that now sits several<BR ALIGN="LEFT"/>screens above - on mobile this really<BR ALIGN="LEFT"/>needs to be a link or a button that<BR ALIGN="LEFT"/>loads the preset and jumps to #db-h</FONT></FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="358"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#14202e"><B>h2 Decade of midnight</B></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672"><B>.band-main .prose</B><BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P1 curfew from Nov 2011 [3]<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P2 mobile out of scope, repealed [4] [5]<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P3 the PC bang rule that outlived it [6]</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>aside "How long things lasted"</B><BR ALIGN="LEFT"/><FONT COLOR="#5b6672">duration preset explained; null end<BR ALIGN="LEFT"/>dates read as still running<BR ALIGN="LEFT"/>p.side-note - computed inside SQLite</FONT></FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD></TR> <TR><TD BGCOLOR="#14202e" CELLPADDING="10"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="354"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#ffffff"><B>A History of the Internet<BR ALIGN="LEFT"/>in South Korea</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#c9ced5">p.foot-note</FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#ffffff"><B>Sources on this page</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#c9ced5">ol.cites#page-cites<BR ALIGN="LEFT"/>1. ____________________<BR ALIGN="LEFT"/>2. ____________________<BR ALIGN="LEFT"/>Full reference list &#8594;</FONT></TD></TR> <TR><TD ALIGN="LEFT" BGCOLOR="#0d1620"><FONT POINT-SIZE="7" COLOR="#9aa3ad">CM1040 - University of London<BR ALIGN="LEFT"/>Back to top &#8593;</FONT></TD></TR> <TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#5b6672">.foot-grid 2 cols becomes stacked</FONT></TD></TR> </TABLE> </TD></TR> </TABLE>>]; }
