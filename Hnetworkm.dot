digraph network_mobile { graph [bgcolor="#ffffff", margin=0.25, label="network.html | mobile", labelloc=t, labeljust=l, fontname="DejaVu Sans Bold", fontsize=17, fontcolor="#14202e"]; node [shape=plaintext, fontname="DejaVu Sans", fontsize=11]; phone [label=< <TABLE BORDER="3" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#ffffff" WIDTH="380"> <TR><TD ALIGN="CENTER" HEIGHT="22" BGCOLOR="#14202e"><FONT POINT-SIZE="8" COLOR="#ffffff">status bar - viewport 390 x 844, single column, page scrolls</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="374" HEIGHT="140" FIXEDSIZE="TRUE" BGCOLOR="#e4e8ec"> <TR><TD ALIGN="LEFT" VALIGN="BOTTOM" CELLPADDING="8"> <FONT POINT-SIZE="7" COLOR="#5b6672">header.hero - img object-fit: cover, ~35-40vh<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="8" COLOR="#2f5d8c">p.kicker KO<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="13" COLOR="#14202e"><B>h1 Wires, Exchanges,<BR ALIGN="LEFT"/>Cables</B><BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="8" COLOR="#5b6672">p.sub wraps to 2-3 lines</FONT> </TD></TR> </TABLE> </TD></TR> <TR><TD BGCOLOR="#f2f3f5" CELLPADDING="0"> <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" WIDTH="374" COLOR="#9aa3ad"> <TR> <TD><FONT POINT-SIZE="8" COLOR="#14202e">Overview<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="8" COLOR="#14202e">Timeline<BR/>KO</FONT></TD> <TD BGCOLOR="#14202e"><FONT POINT-SIZE="8" COLOR="#ffffff"><B>Network</B><BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="8" COLOR="#14202e">PC Bang<BR/>KO</FONT></TD> <TD BGCOLOR="#e4e8ec"><FONT POINT-SIZE="12" COLOR="#5b6672">&#8250;</FONT></TD> </TR> <TR><TD COLSPAN="5" BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#5b6672">nav.topbar - horizontal scroll strip, current item scrolled into view; Culture / Policy / References off-screen right</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="358"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#14202e"><B>h2 The Network Mapped<BR ALIGN="LEFT"/>(Revisited!)</B></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c04c4c" STYLE="DASHED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" WIDTH="344"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#c04c4c">#graph-error [hidden] role="alert"</FONT></TD></TR></TABLE> </TD></TR> <TR><TD> <TABLE BORDER="2" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="344" HEIGHT="215" FIXEDSIZE="TRUE" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="CENTER" VALIGN="MIDDLE"><FONT POINT-SIZE="10" COLOR="#14202e"><B>div#cy</B><BR/><FONT POINT-SIZE="7" COLOR="#5b6672">height drops to 400px at max-width 560px<BR/>(media query already in the head)<BR/><BR/>10 nodes in ~344px: labels will overlap, so<BR/>"Fit" should run on load and after rotate.<BR/>Cytoscape pan/zoom captures touch, so the<BR/>page cannot be scrolled by dragging inside<BR/>this box - leave margin either side of it.<BR/>Node hit area needs ~44px for taps.</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>div#net-detail .tl-detail</B> aria-live<BR ALIGN="LEFT"/><FONT COLOR="#5b6672">sits directly under the map so a tapped<BR ALIGN="LEFT"/>node's p.tl-when / h3.tl-title / p.tl-note<BR ALIGN="LEFT"/>land in view without scrolling. Reserve<BR ALIGN="LEFT"/>~3 lines of min-height.</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="344" BGCOLOR="#f2f3f5"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e">&#9656; "View this data as table"<BR ALIGN="LEFT"/><FONT COLOR="#5b6672">the real small-screen route into the data.<BR ALIGN="LEFT"/>4 columns will not fit 344px - wrap the<BR ALIGN="LEFT"/>table in an overflow-x container or stack<BR ALIGN="LEFT"/>each row as a labelled block.<BR ALIGN="LEFT"/>caption keeps the data/network.json link.</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#14202e"><B>aside.band-side "Using this!"</B> (below)</FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">instructions paragraph. Reword for touch:<BR ALIGN="LEFT"/>"drag" and "click" read as mouse verbs.</FONT></TD></TR> <TR><TD> <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="7" WIDTH="330" COLOR="#2f5d8c"> <TR> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#2f5d8c">Map</FONT></TD> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#2f5d8c">Circle</FONT></TD> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#2f5d8c">Fit</FONT></TD> </TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#5b6672">div.tl-bar - 3 buttons stay in one row, 44px tall</FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e">ul.graph-key - 2 x 2 swatch grid<BR ALIGN="LEFT"/>&#9679; provider &#9679; exchange<BR ALIGN="LEFT"/>&#9679; research &#9679; cable</FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">p.side-note - line styles legend</FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="358"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#14202e"><B>h2 Who owns the wires?</B></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672"><B>.band-main .prose</B> (1st in flow)<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P1 three-operator split, KT 41% [1]<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P2 Oct 2021 KT outage [2] [3]<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P3 peering, link to Culture</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>aside "Market share, 2023"</B><BR ALIGN="LEFT"/>dl.scope stacks dt over dd:<BR ALIGN="LEFT"/>KT / ~41% - 9.8m<BR ALIGN="LEFT"/>SK Broadband / ~29% - 6.8m<BR ALIGN="LEFT"/>LG U+ / ~21% - 5.1m<BR ALIGN="LEFT"/><FONT COLOR="#5b6672">p.side-note + [1]</FONT></FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="358"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#14202e"><B>h2 Where traffic meets</B></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672"><B>.band-main .prose</B><BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P1 pre-1995 Pacific detour, first IX<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P2 KINX, June 1999, sixteen members<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P3 five exchanges, nine cables [1]</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>aside "But why neutrality<BR ALIGN="LEFT"/>matters?"</B><BR ALIGN="LEFT"/><FONT COLOR="#5b6672">2 paragraphs - longest aside on<BR ALIGN="LEFT"/>the page, consider clamping it or<BR ALIGN="LEFT"/>putting it in a details toggle here<BR ALIGN="LEFT"/>p.side-note KINX since 1999</FONT></FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="358"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#14202e"><B>h2 Fast, as said, no<BR ALIGN="LEFT"/>longer exceptional</B></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672"><B>.band-main .prose</B><BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P1 2006 OECD, 2011 Akamai [4] [5]<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P2 233 Mbps median [6]<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P3 closing argument</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>aside "Then and now"</B><BR ALIGN="LEFT"/>2006 / 94% of households [4]<BR ALIGN="LEFT"/>2011 / 17.5 Mbps [5]<BR ALIGN="LEFT"/>2025 / 233 Mbps, 97.2% [7]</FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD></TR> <TR><TD BGCOLOR="#14202e" CELLPADDING="10"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="354"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#ffffff"><B>A History of the Internet<BR ALIGN="LEFT"/>in South Korea</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#c9ced5">p.foot-note</FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#ffffff"><B>Sources on this page</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#c9ced5">ol.cites#page-cites<BR ALIGN="LEFT"/>1. ____________________<BR ALIGN="LEFT"/>2. ____________________<BR ALIGN="LEFT"/>3. ____________________<BR ALIGN="LEFT"/>Full reference list &#8594;</FONT></TD></TR> <TR><TD ALIGN="LEFT" BGCOLOR="#0d1620"><FONT POINT-SIZE="7" COLOR="#9aa3ad">CM1040 - University of London<BR ALIGN="LEFT"/>Back to top &#8593;</FONT></TD></TR> <TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#5b6672">.foot-grid 2 cols becomes stacked</FONT></TD></TR> </TABLE> </TD></TR> </TABLE>>]; }
