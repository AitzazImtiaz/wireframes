digraph references_mobile { graph [bgcolor="#ffffff", margin=0.25, label="references.html | mobile", labelloc=t, labeljust=l, fontname="DejaVu Sans Bold", fontsize=17, fontcolor="#14202e"]; node [shape=plaintext, fontname="DejaVu Sans", fontsize=11]; phone [label=< <TABLE BORDER="3" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#ffffff" WIDTH="380"> <TR><TD ALIGN="CENTER" HEIGHT="22" BGCOLOR="#14202e"><FONT POINT-SIZE="8" COLOR="#ffffff">status bar - viewport 390 x 844, single column, page scrolls</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="374" HEIGHT="140" FIXEDSIZE="TRUE" BGCOLOR="#e4e8ec"> <TR><TD ALIGN="LEFT" VALIGN="BOTTOM" CELLPADDING="8"> <FONT POINT-SIZE="7" COLOR="#5b6672">header.hero - img object-fit: cover, ~35-40vh<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="8" COLOR="#2f5d8c">p.kicker KO<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="13" COLOR="#14202e"><B>h1 Sources and Credits</B><BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="8" COLOR="#5b6672">p.sub one line</FONT> </TD></TR> </TABLE> </TD></TR> <TR><TD BGCOLOR="#f2f3f5" CELLPADDING="0"> <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" WIDTH="374" COLOR="#9aa3ad"> <TR> <TD><FONT POINT-SIZE="8" COLOR="#14202e">PC Bang<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="8" COLOR="#14202e">Culture<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="8" COLOR="#14202e">Policy<BR/>KO</FONT></TD> <TD BGCOLOR="#14202e"><FONT POINT-SIZE="8" COLOR="#ffffff"><B>References</B><BR/>KO</FONT></TD> </TR> <TR><TD COLSPAN="4" BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#5b6672">nav.topbar - scroll strip at its right end: the current item is last, so the strip should be scrolled to show it</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="358"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#14202e"><B>article#main - h2 "Sources"</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="7" COLOR="#5b6672">no .band, no aside - the mobile layout is<BR ALIGN="LEFT"/>identical to the desktop one, just narrower.<BR ALIGN="LEFT"/>This is the simplest page on the site.</FONT></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">p - intro paragraph, 4-5 lines here<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>_____________________________</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="2" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="344" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#14202e"><B>div#ref-list</B> <FONT POINT-SIZE="7" COLOR="#5b6672">built by refs.js</FONT></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="330" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>[1]</B> publisher, title, year<BR ALIGN="LEFT"/><FONT POINT-SIZE="7" COLOR="#2f5d8c">https://a-long-url-that-will-not-fit...<BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#c04c4c">long URLs overflow 344px - set<BR ALIGN="LEFT"/>overflow-wrap: anywhere, or show the<BR ALIGN="LEFT"/>domain as the link text instead<BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#5b6672">used on: Overview, Network</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="330" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>[2]</B> _______________________<BR ALIGN="LEFT"/><FONT POINT-SIZE="7" COLOR="#5b6672">link, then where it is used</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="330" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>[3]</B> _______________________</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="330" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>[4]</B> _______________________</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#5b6672">... 15-20 entries, so this is a long scroll on<BR ALIGN="LEFT"/>a phone. Links need 44px of tap height, and<BR ALIGN="LEFT"/>the "used on" back-links are what make the<BR ALIGN="LEFT"/>page worth opening from an inline [n] chip.</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#c04c4c">no &lt;noscript&gt; on this page: with JS off a mobile reader gets the hero, the nav,<BR ALIGN="LEFT"/>a heading and one paragraph, then nothing. Add the warning the other pages have,<BR ALIGN="LEFT"/>or ship a static fallback list inside #ref-list for refs.js to replace.</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD BGCOLOR="#14202e" CELLPADDING="10"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="354"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#ffffff"><B>A History of the Internet<BR ALIGN="LEFT"/>in South Korea</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#c9ced5">p.foot-note</FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#ffffff"><B>About the sources</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#c9ced5">prose here, not ol.cites#page-cites -<BR ALIGN="LEFT"/>KISA and MSIT preferred over secondary<BR ALIGN="LEFT"/>reporting. No "Full reference list" link.</FONT></TD></TR> <TR><TD ALIGN="LEFT" BGCOLOR="#0d1620"><FONT POINT-SIZE="7" COLOR="#9aa3ad">CM1040 - University of London<BR ALIGN="LEFT"/>Back to top &#8593;</FONT></TD></TR> <TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#5b6672">.foot-grid 2 cols becomes stacked</FONT></TD></TR> </TABLE> </TD></TR> </TABLE>>]; }
