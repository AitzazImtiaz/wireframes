digraph timeline_laptop { graph [bgcolor="#ffffff", margin=0.25, label="timeline.html | laptop", labelloc=t, labeljust=l, fontname="DejaVu Sans Bold", fontsize=17, fontcolor="#14202e"]; node [shape=plaintext, fontname="DejaVu Sans", fontsize=11]; page [label=< <TABLE BORDER="2" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#ffffff" WIDTH="1060"> <TR><TD ALIGN="LEFT" HEIGHT="24" BGCOLOR="#dde1e6"><FONT POINT-SIZE="9" COLOR="#5b6672"> viewport 1280 x 800 - no gate on this page - a.skip then &lt;noscript&gt; above the hero (p5 canvas means the JS warning matters here)</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="1060" HEIGHT="150" FIXEDSIZE="TRUE" BGCOLOR="#e4e8ec"> <TR><TD ALIGN="LEFT" VALIGN="BOTTOM" CELLPADDING="14"> <FONT POINT-SIZE="9" COLOR="#5b6672">header.hero - img.hero-img full bleed (header.jpg), .hero-text / .hero-inner overlay<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="9" COLOR="#2f5d8c">p.kicker KO (yeonpyo)<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="19" COLOR="#14202e"><B>h1 Twenty Years in a Film!</B> <FONT POINT-SIZE="8" COLOR="#5b6672">("Film" is a &lt;b&gt; inside the h1)</FONT><BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="10" COLOR="#5b6672">p.sub every milestone from October 2006 to present</FONT> </TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" WIDTH="1060" BGCOLOR="#f2f3f5" COLOR="#9aa3ad"> <TR> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Overview<BR/>KO</FONT></TD> <TD BGCOLOR="#14202e"><FONT POINT-SIZE="9" COLOR="#ffffff"><B>Timeline</B><BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Network<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">PC Bang<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Culture<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Policy<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">References<BR/>KO</FONT></TD> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#5b6672">nav.topbar - 7 items, one row<BR/>aria-current="page" on Timeline</FONT></TD> </TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="10"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1030" BGCOLOR="#ffffff"> <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#14202e"><B>section.band - h2 "Twenty years; event by event"</B></FONT></TD></TR> <TR> <TD WIDTH="670" VALIGN="TOP"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" WIDTH="655"> <TR><TD> <TABLE BORDER="1" COLOR="#c04c4c" STYLE="DASHED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" WIDTH="655"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#c04c4c">#tl-error [hidden] role="alert" - shows on a bad/missing data/timeline.json, or a row failing the YYYY-MM check</FONT></TD></TR></TABLE> </TD></TR> <TR><TD> <TABLE BORDER="2" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="655" HEIGHT="245" FIXEDSIZE="TRUE" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="CENTER" VALIGN="MIDDLE"><FONT POINT-SIZE="11" COLOR="#14202e"><B>div.tl-canvas#tl-canvas - p5.js canvas mounts here</B><BR/><FONT POINT-SIZE="9" COLOR="#5b6672">the "film strip": 2006 at the left edge, present at the right<BR/>filled dots = passed, hollow dots = ahead of the playhead,<BR/>ringed dot = current event, colour = thread/category<BR/><BR/>needs an explicit height in timeline.css (p5 sizes to the parent)<BR/>and a windowResized handler, since the strip is width-driven</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="655" BGCOLOR="#ffffff"> <TR><TD> <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="6" WIDTH="641" COLOR="#2f5d8c"> <TR> <TD BGCOLOR="#14202e"><FONT POINT-SIZE="9" COLOR="#ffffff"><B>#tl-play "Play"</B><BR/><FONT POINT-SIZE="7">aria-pressed</FONT></FONT></TD> <TD BORDER="0"><FONT POINT-SIZE="9" COLOR="#14202e"><B>#tl-year</B><BR/><FONT POINT-SIZE="7" COLOR="#5b6672">"January 2006"</FONT></FONT></TD> <TD BORDER="0"><FONT POINT-SIZE="9" COLOR="#14202e"><B>#tl-count</B><BR/><FONT POINT-SIZE="7" COLOR="#5b6672">"0 events"</FONT></FONT></TD> <TD BORDER="0"><FONT POINT-SIZE="7" COLOR="#9aa3ad">.tl-spacer<BR/>(flex: 1, pushes<BR/>the rest right)</FONT></TD> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#2f5d8c">#tl-prev<BR/>Prev</FONT></TD> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#2f5d8c">#tl-next<BR/>Next</FONT></TD> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#2f5d8c">#tl-reset<BR/>Reset</FONT></TD> </TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">div.tl-bar - one flex row: transport on the left, step controls on the right. #tl-year and #tl-count change on every tick,<BR ALIGN="LEFT"/>so give them a fixed min-width or the buttons will jitter as the text length changes during playback.</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" WIDTH="655" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#14202e"><B>div#tl-detail .tl-detail aria-live="polite"</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#5b6672">#tpl-tl-detail writes p.tl-when ("2011-06 - Policy") + h3.tl-title + p.tl-note with an optional inline [n] cite.<BR ALIGN="LEFT"/>Rewritten on every playhead step, so a min-height for the tallest note stops the table below from sliding.</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="655" BGCOLOR="#f2f3f5"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#14202e">&#9656; details#tl-details / summary "View every event as table"</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#5b6672">collapsed by default. Open = table#tl-table, caption links data/timeline.json, columns: When | Event | Thread<BR ALIGN="LEFT"/>tbody#tl-tbody from #tpl-tl-rows - each &lt;tr&gt; is role="button" tabindex="0" aria-selected, so rows are<BR ALIGN="LEFT"/>clickable seek targets and need a visible :focus and [aria-selected="true"] style, not just a hover colour</FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD> <TD WIDTH="345" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="330" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#14202e"><B>aside.band-side - h3.side-h "On Next!"</B></FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">instructions paragraph: press play (~20s<BR ALIGN="LEFT"/>run), hollow vs ringed dots, arrow keys,<BR ALIGN="LEFT"/>drag the slider, click an event or a row</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="310" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>ul.graph-key.tl-key#tl-key</B> - empty in<BR ALIGN="LEFT"/>the HTML, built from #tpl-tl-key<BR ALIGN="LEFT"/>&#9679; Infrastructure<BR ALIGN="LEFT"/>&#9679; Mobile<BR ALIGN="LEFT"/>&#9679; Platform<BR ALIGN="LEFT"/>&#9679; Policy<BR ALIGN="LEFT"/>&#9679; Incident<BR ALIGN="LEFT"/><FONT COLOR="#c04c4c">each li is role="button" aria-pressed<BR ALIGN="LEFT"/>= a thread filter, not just a legend.<BR ALIGN="LEFT"/>Style the pressed state clearly.</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">p.side-note - the author's reading of the<BR ALIGN="LEFT"/>infrastructure vs policy threads</FONT></TD></TR> </TABLE> </TD> </TR> <TR><TD COLSPAN="2"> <TABLE BORDER="1" COLOR="#c04c4c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="1010" BGCOLOR="#fdf6f6"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#14202e"><B>p.tl-sources#tl-sources</B> - filled by #tpl-tl-sources with the [n] chips for every event shown</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#c04c4c">this &lt;p&gt; is a direct child of section.band, after the aside, so in a 2-column grid it becomes a THIRD grid item and<BR ALIGN="LEFT"/>drops into the next cell (under the aside) rather than under the canvas. Give it grid-column: 1 / -1 to span, as drawn.</FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="10"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1030" BGCOLOR="#ffffff"> <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#14202e"><B>section.band - h2 "What shape shouts ?!"</B></FONT></TD></TR> <TR> <TD WIDTH="670" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="655" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#5b6672"><B>.band-main .prose - 4 paragraphs, ~70ch measure</B><BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P1 short lead-in: three things stand out<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P2 infrastructure front-loads, done by 5G in 2019<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P3 policy is reactive: Shutdown Law, peering<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P4 platform thread never stops - KakaoTalk, webtoons,<BR ALIGN="LEFT"/>Squid Game. Holds an &lt;em&gt; and an external YouTube link<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>this band has no &lt;cite&gt; markers - all of its sources sit in<BR ALIGN="LEFT"/>#tl-sources in the band above</FONT></TD></TR> </TABLE> </TD> <TD WIDTH="345" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="330" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#14202e"><B>aside - h3 "About data"</B></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="310" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e">dl.scope - 3 dt/dd pairs, dd runs long here<BR ALIGN="LEFT"/><B>Source</B><BR ALIGN="LEFT"/>3-4 lines about the JSON record<BR ALIGN="LEFT"/><B>Validation Criterion</B><BR ALIGN="LEFT"/>3-4 lines, contains a &lt;code&gt; chip:<BR ALIGN="LEFT"/>&nbsp;&nbsp;YYYY-MM<BR ALIGN="LEFT"/><B>Rendering</B><BR ALIGN="LEFT"/>3-4 lines on p5 + shared array</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">the longest aside on the page - it will<BR ALIGN="LEFT"/>outrun the prose column beside it</FONT></TD></TR> </TABLE> </TD> </TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="1060" BGCOLOR="#14202e"> <TR><TD CELLPADDING="12"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1030"> <TR> <TD WIDTH="515" VALIGN="TOP" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#ffffff"><B>.foot-col - p.foot-title site name</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="8" COLOR="#c9ced5">.foot-note - 20 years, 7 Oct 2006 to present</FONT></TD> <TD WIDTH="515" VALIGN="TOP" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#ffffff"><B>.foot-col - h2 "Sources on this page"</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="8" COLOR="#c9ced5">ol.cites#page-cites - on this page refs.js has to pick up the<BR ALIGN="LEFT"/>cites injected into #tl-sources and #tl-detail AFTER the JSON<BR ALIGN="LEFT"/>loads, so the list grows late; then a link to references.html</FONT></TD> </TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8" BGCOLOR="#0d1620"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" WIDTH="1030"> <TR> <TD ALIGN="LEFT" WIDTH="800"><FONT POINT-SIZE="8" COLOR="#9aa3ad">.foot-base - CM1040 Web Development, University of London, media credits</FONT></TD> <TD ALIGN="RIGHT" WIDTH="230"><FONT POINT-SIZE="8" COLOR="#9aa3ad">Back to top &#8593;</FONT></TD> </TR> </TABLE> </TD></TR> </TABLE> </TD></TR> </TABLE>>]; }
