digraph culture_mobile { graph [bgcolor="#ffffff", margin=0.25, label="culture.html | mobile", labelloc=t, labeljust=l, fontname="DejaVu Sans Bold", fontsize=17, fontcolor="#14202e"]; node [shape=plaintext, fontname="DejaVu Sans", fontsize=11]; phone [label=< <TABLE BORDER="3" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#ffffff" WIDTH="380"> <TR><TD ALIGN="CENTER" HEIGHT="22" BGCOLOR="#14202e"><FONT POINT-SIZE="8" COLOR="#ffffff">status bar - viewport 390 x 844 - below the 860px media query</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="374" HEIGHT="140" FIXEDSIZE="TRUE" BGCOLOR="#e4e8ec"> <TR><TD ALIGN="LEFT" VALIGN="BOTTOM" CELLPADDING="8"> <FONT POINT-SIZE="7" COLOR="#5b6672">header.hero - img object-fit: cover, ~35-40vh<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="8" COLOR="#2f5d8c">p.kicker KO<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="13" COLOR="#14202e"><B>h1 Who Pays for a<BR ALIGN="LEFT"/>Hit Show?</B><BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="8" COLOR="#5b6672">p.sub wraps to 2 lines</FONT> </TD></TR> </TABLE> </TD></TR> <TR><TD BGCOLOR="#f2f3f5" CELLPADDING="0"> <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" WIDTH="374" COLOR="#9aa3ad"> <TR> <TD><FONT POINT-SIZE="8" COLOR="#14202e">Network<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="8" COLOR="#14202e">PC Bang<BR/>KO</FONT></TD> <TD BGCOLOR="#14202e"><FONT POINT-SIZE="8" COLOR="#ffffff"><B>Culture</B><BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="8" COLOR="#14202e">Policy<BR/>KO</FONT></TD> <TD BGCOLOR="#e4e8ec"><FONT POINT-SIZE="12" COLOR="#5b6672">&#8250;</FONT></TD> </TR> <TR><TD COLSPAN="5" BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#5b6672">nav.topbar - scroll strip, current item scrolled into view. Its height is var(--bar-h), reused by the sticky figure offset</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="358"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#14202e"><B>h2 The Netflix Dilemna</B></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672"><B>.band-main .prose</B> - one paragraph<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>"scroll through for this case study"</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>aside "A note on the line!"</B><BR ALIGN="LEFT"/><FONT COLOR="#5b6672">interpolation caveat - lands directly<BR ALIGN="LEFT"/>above the chart here, which reads<BR ALIGN="LEFT"/>better than the desktop placement</FONT></FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8"> <TABLE BORDER="1" COLOR="#c04c4c" STYLE="DASHED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="358" BGCOLOR="#fdf6f6"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#c04c4c">div#cu-error [hidden] role="alert" - full width, sits between the sections</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8"> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="358"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#14202e"><B>section.scrolly</B> <FONT POINT-SIZE="7" COLOR="#5b6672">grid-template-columns: 1fr<BR ALIGN="LEFT"/>(one column below 860px)</FONT></FONT></TD></TR> <TR><TD> <TABLE BORDER="2" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="344" HEIGHT="165" FIXEDSIZE="TRUE" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="CENTER" VALIGN="MIDDLE"><FONT POINT-SIZE="9" COLOR="#14202e"><B>div.scrolly-fig &gt; svg#cu-chart</B><BR/><FONT POINT-SIZE="7" COLOR="#5b6672">still sticky: top calc(var(--bar-h) + 8px),<BR/>background var(--paper), padding 8px 0, z-index 1<BR/>so it PINS TO THE TOP of the screen and the<BR/>steps scroll underneath it<BR/><BR/>at ~344px the mono 9-11px tick and mark labels<BR/>are near their floor - thin them out or drop the<BR/>.cu-marklab text and keep only the rules</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#c04c4c">the pinned figure eats the top ~200px of a 844px screen. Give it a max-height (say 30vh)<BR ALIGN="LEFT"/>or the reader is left a narrow slot to read each step in.</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="344" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>div.cu-steps</B> <FONT POINT-SIZE="7" COLOR="#5b6672">padding-top drops 30vh to 4vh<BR ALIGN="LEFT"/>so step 1 starts almost immediately</FONT></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="330" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#5b6672">JANUARY 2016<BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="10" COLOR="#14202e"><B>Netflix arrives</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#5b6672">p - "arrive", .is-on</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD HEIGHT="22" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#9aa3ad">margin-bottom 50vh (was 60vh)</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="330" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#9aa3ad">MAY 2018 / <B>50 Gbps</B> - "fifty" [n]</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="330" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#9aa3ad">APRIL 2020 / <B>Netflix sues first</B> - "sue" [n]</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="330" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#9aa3ad">JUNE 2021 / <B>Court disagrees</B> - "ruling" [n]</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="330" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#9aa3ad">SEPTEMBER 2021 / <B>1,200 Gbps</B> - "twelve" [n]</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="330" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#9aa3ad">2022 / <B>Seven percent of everything</B> - "share" [n]</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="330" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#9aa3ad">SEPTEMBER 2023 / <B>Both sides walk away</B> - "settle" [n]</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD HEIGHT="26" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#9aa3ad">padding-bottom 40vh tail</FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#c04c4c">7 steps x 50vh still means ~4 screens of scrolling on a phone.<BR ALIGN="LEFT"/>Steps are divs with no focusable content, so nothing here is<BR ALIGN="LEFT"/>reachable by keyboard or reads in order without scrolling.</FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="358"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#14202e"><B>h2 Why it mattered<BR ALIGN="LEFT"/>beyond Korea</B></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672"><B>.band-main .prose</B> (1st in flow)<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P1 cases abroad, eight bills [1] [2]<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P2 settled, no precedent<BR ALIGN="LEFT"/>_____________________________<BR ALIGN="LEFT"/>P3 link back to Network</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="344" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e"><B>aside "Figures"</B> - dl.scope, 4 pairs<BR ALIGN="LEFT"/>Traffic growth / 50 to 1,200 Gbps<BR ALIGN="LEFT"/>Share / at least 7% (KISDI)<BR ALIGN="LEFT"/>Disputed sum / 27.2 billion won<BR ALIGN="LEFT"/>Duration / five years</FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD></TR> <TR><TD BGCOLOR="#14202e" CELLPADDING="10"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="354"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#ffffff"><B>A History of the Internet<BR ALIGN="LEFT"/>in South Korea</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#c9ced5">p.foot-note</FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#ffffff"><B>Sources on this page</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#c9ced5">ol.cites#page-cites<BR ALIGN="LEFT"/>1. ____________________<BR ALIGN="LEFT"/>2. ____________________<BR ALIGN="LEFT"/>Full reference list &#8594;</FONT></TD></TR> <TR><TD ALIGN="LEFT" BGCOLOR="#0d1620"><FONT POINT-SIZE="7" COLOR="#9aa3ad">CM1040 - University of London<BR ALIGN="LEFT"/>Back to top &#8593;</FONT></TD></TR> <TR><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#5b6672">.foot-grid 2 cols becomes stacked</FONT></TD></TR> </TABLE> </TD></TR> </TABLE>>]; }
