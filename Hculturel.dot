digraph culture_laptop { graph [bgcolor="#ffffff", margin=0.25, label="culture.html | laptop", labelloc=t, labeljust=l, fontname="DejaVu Sans Bold", fontsize=17, fontcolor="#14202e"]; node [shape=plaintext, fontname="DejaVu Sans", fontsize=11]; page [label=< <TABLE BORDER="2" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#ffffff" WIDTH="1060"> <TR><TD ALIGN="LEFT" HEIGHT="24" BGCOLOR="#dde1e6"><FONT POINT-SIZE="9" COLOR="#5b6672"> viewport 1280 x 800 - a.skip then &lt;noscript&gt; above the hero - page-specific &lt;style&gt; block in the head owns .scrolly / .cu-* </FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="1060" HEIGHT="150" FIXEDSIZE="TRUE" BGCOLOR="#e4e8ec"> <TR><TD ALIGN="LEFT" VALIGN="BOTTOM" CELLPADDING="14"> <FONT POINT-SIZE="9" COLOR="#5b6672">header.hero - img.hero-img full bleed (header.jpg), .hero-text / .hero-inner overlay<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="9" COLOR="#2f5d8c">p.kicker KO (online culture)<BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="19" COLOR="#14202e"><B>h1 Who Pays for a Hit Show?</B><BR ALIGN="LEFT"/></FONT> <FONT POINT-SIZE="10" COLOR="#5b6672">p.sub five years, twenty four times more traffic</FONT> </TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" WIDTH="1060" BGCOLOR="#f2f3f5" COLOR="#9aa3ad"> <TR> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Overview<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Timeline<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Network<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">PC Bang<BR/>KO</FONT></TD> <TD BGCOLOR="#14202e"><FONT POINT-SIZE="9" COLOR="#ffffff"><B>Culture</B><BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">Policy<BR/>KO</FONT></TD> <TD><FONT POINT-SIZE="9" COLOR="#14202e">References<BR/>KO</FONT></TD> <TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8" COLOR="#5b6672">nav.topbar - 7 items, one row<BR/>aria-current="page" on Culture<BR/>its height feeds var(--bar-h), used<BR/>by the sticky offset below</FONT></TD> </TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="10"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1030" BGCOLOR="#ffffff"> <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#14202e"><B>section.band - h2 "The Netflix Dilemna"</B></FONT></TD></TR> <TR> <TD WIDTH="670" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="655" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#5b6672"><B>.band-main .prose - a single short paragraph</B><BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>sets up the question and says "scroll through"<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>this band is only an intro, so it should be short enough that<BR ALIGN="LEFT"/>the chart below is visible before the reader starts scrolling</FONT></TD></TR> </TABLE> </TD> <TD WIDTH="345" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="330" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#14202e"><B>aside.band-side - "A note on the line!"</B></FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">only two public measurements exist, so<BR ALIGN="LEFT"/>the line is interpolation - dots are data.<BR ALIGN="LEFT"/>This caveat belongs beside the chart, so<BR ALIGN="LEFT"/>consider repeating it as an svg caption.</FONT></TD></TR> </TABLE> </TD> </TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="10"> <TABLE BORDER="1" COLOR="#c04c4c" STYLE="DASHED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="1030" BGCOLOR="#fdf6f6"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#c04c4c"><B>div#cu-error [hidden] role="alert"</B> - direct child of &lt;article&gt;, between the two sections, so it spans full width.<BR ALIGN="LEFT"/>Styled in the head block: left border 3px var(--hanbok) + tinted background. Shown if the chart data fails.</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="10"> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1030" BGCOLOR="#ffffff"> <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#14202e"><B>section.scrolly</B> <FONT POINT-SIZE="9" COLOR="#5b6672">aria-label="The Netflix and SK Broadband dispute" - grid: minmax(0,1fr) 340px, gap 0 56px</FONT></FONT></TD></TR> <TR> <TD WIDTH="655" VALIGN="TOP"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" WIDTH="640"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#14202e"><B>div.scrolly-fig</B> - <FONT COLOR="#5b6672">position: sticky, top: calc(var(--bar-h) + 24px), height: fit-content</FONT></FONT></TD></TR> <TR><TD> <TABLE BORDER="2" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="640" HEIGHT="300" FIXEDSIZE="TRUE" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="CENTER" VALIGN="MIDDLE"><FONT POINT-SIZE="11" COLOR="#14202e"><B>svg#cu-chart - empty in the HTML, drawn by culture.bundle.js</B><BR/><FONT POINT-SIZE="9" COLOR="#5b6672">width: 100%, height: auto, display: block<BR/><BR/>traffic 50 Gbps (May 2018) to 1,200 Gbps (Sept 2021)<BR/>.cu-grid gridlines, .cu-ylab / .cu-xlab mono tick labels<BR/>.cu-line drawn with a stroke-dashoffset transition (line reveals)<BR/>.cu-dot + .cu-dotlab for the two real measurements (r animates)<BR/>.cu-mark event rules, greyed until .is-on; .cu-marklab is<BR/>fill: transparent until .is-on, so labels fade in per step<BR/><BR/>this pane stays pinned while the column beside it scrolls</FONT></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5b6672">the figure is the FIRST child, so it takes the wide 1fr column on the left;<BR ALIGN="LEFT"/>the steps take the fixed 340px column on the right</FONT></TD></TR> </TABLE> </TD> <TD WIDTH="355" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="340" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#14202e"><B>div.cu-steps</B> - 340px fixed<BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#5b6672">padding-top: 30vh, padding-bottom: 40vh</FONT></FONT></TD></TR> <TR><TD HEIGHT="34" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#9aa3ad">30vh of empty lead-in</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="326" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#5b6672">P.WHEN - JANUARY 2016<BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="10" COLOR="#14202e"><B>h3 Netflix arrives</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#5b6672">p - 3 lines, 14px / 1.65<BR ALIGN="LEFT"/><B>.cu-step[data-step="arrive"] .is-on</B></FONT></TD></TR> </TABLE> </TD></TR> <TR><TD HEIGHT="26" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#9aa3ad">margin-bottom: 60vh between every step</FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="326" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#9aa3ad">MAY 2018<BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="10" COLOR="#9aa3ad">h3 50 Gbps<BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#9aa3ad">p + [n] - "fifty" (opacity .35, off)</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="326" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#9aa3ad">APRIL 2020<BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="10" COLOR="#9aa3ad">h3 Netflix sues first<BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#9aa3ad">p + [n] - "sue"</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="326" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#9aa3ad">JUNE 2021<BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="10" COLOR="#9aa3ad">h3 Court disagrees<BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#9aa3ad">p + [n] - "ruling"</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="326" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#9aa3ad">SEPTEMBER 2021<BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="10" COLOR="#9aa3ad">h3 1,200 Gbps<BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#9aa3ad">p, holds an &lt;em&gt; + [n] - "twelve"</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="326" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#9aa3ad">2022<BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="10" COLOR="#9aa3ad">h3 Seven percent of everything<BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#9aa3ad">p + [n] - "share"</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="326" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#9aa3ad">SEPTEMBER 2023<BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="10" COLOR="#9aa3ad">h3 Both sides walk away mutually<BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="7" COLOR="#9aa3ad">p + [n] - "settle" (last step)</FONT></TD></TR> </TABLE> </TD></TR> <TR><TD HEIGHT="40" ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#9aa3ad">40vh of tail padding, so the last step<BR ALIGN="LEFT"/>can reach the middle of the screen</FONT></TD></TR> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#c04c4c">7 steps x 60vh of margin makes this section roughly 5<BR ALIGN="LEFT"/>screens tall. There is no keyboard or reduced-motion path<BR ALIGN="LEFT"/>through it: the steps are divs, so a reader who does not<BR ALIGN="LEFT"/>scroll gets 6 of 7 at opacity .35.</FONT></TD></TR> </TABLE> </TD> </TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="10"> <TABLE BORDER="1" COLOR="#9aa3ad" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1030" BGCOLOR="#ffffff"> <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#14202e"><B>section.band - h2 "Why it mattered beyond Korea"</B></FONT></TD></TR> <TR> <TD WIDTH="670" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="655" BGCOLOR="#f7f8fa"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#5b6672"><B>.band-main .prose - 3 paragraphs, ~70ch measure</B><BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P1 copycat cases abroad, eight bills [n] [n]<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P2 settled with no precedent<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>_____________________________________________<BR ALIGN="LEFT"/>P3 three-operator structure, inline link back to Network<BR ALIGN="LEFT"/>_____________________________________________</FONT></TD></TR> </TABLE> </TD> <TD WIDTH="345" VALIGN="TOP"> <TABLE BORDER="1" COLOR="#2f5d8c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="330" BGCOLOR="#f2f6fb"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#14202e"><B>aside - "Figures"</B></FONT></TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#c9ced5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" WIDTH="310" BGCOLOR="#ffffff"> <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#14202e">dl.scope - 4 dt/dd pairs<BR ALIGN="LEFT"/><B>Traffic growth</B> 50 to 1,200 Gbps<BR ALIGN="LEFT"/><B>Share of national traffic</B> 7% (KISDI)<BR ALIGN="LEFT"/><B>Disputed sum</B> 27.2 billion won / year<BR ALIGN="LEFT"/><B>Duration</B> five years, no ruling</FONT></TD></TR> </TABLE> </TD></TR> </TABLE> </TD> </TR> </TABLE> </TD></TR> <TR><TD> <TABLE BORDER="1" COLOR="#14202e" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="1060" BGCOLOR="#14202e"> <TR><TD CELLPADDING="12"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="1030"> <TR> <TD WIDTH="515" VALIGN="TOP" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#ffffff"><B>.foot-col - p.foot-title site name</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="8" COLOR="#c9ced5">.foot-note - 20 years, 7 Oct 2006 to present</FONT></TD> <TD WIDTH="515" VALIGN="TOP" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#ffffff"><B>.foot-col - h2 "Sources on this page"</B><BR ALIGN="LEFT"/></FONT><FONT POINT-SIZE="8" COLOR="#c9ced5">ol.cites#page-cites - most cites on this page live inside the<BR ALIGN="LEFT"/>.cu-step blocks, so the numbering follows scroll order:<BR ALIGN="LEFT"/>koreaherald, kedglobal, techcrunch, bloomberg</FONT></TD> </TR> </TABLE> </TD></TR> <TR><TD CELLPADDING="8" BGCOLOR="#0d1620"> <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" WIDTH="1030"> <TR> <TD ALIGN="LEFT" WIDTH="800"><FONT POINT-SIZE="8" COLOR="#9aa3ad">.foot-base - CM1040 Web Development, University of London, media credits</FONT></TD> <TD ALIGN="RIGHT" WIDTH="230"><FONT POINT-SIZE="8" COLOR="#9aa3ad">Back to top &#8593;</FONT></TD> </TR> </TABLE> </TD></TR> </TABLE> </TD></TR> </TABLE>>]; }
